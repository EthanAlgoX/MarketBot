+def test_shutdown_fences_late_model_settlement_and_keeps_full_prepaid_debit(stores, monkeypatch):
+    from threading import Event
+    service, binding = setup(stores, monkeypatch)
+    fence = research.start_research_owner()
+    service.owner = fence
+    request_id = running(service, binding)
+    entered, release = Event(), Event()
+    response = SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content='Late offline fixture'))],
+                               usage=SimpleNamespace(prompt_tokens=10, completion_tokens=2, total_tokens=12))
+    def physical(**kwargs):
+        entered.set()
+        assert release.wait(3)
+        return response
+    monkeypatch.setitem(sys.modules, 'litellm', SimpleNamespace(completion=physical))
+    def run():
+        with research.research_execution_scope(service, binding, request_id):
+            return research.assistant_completion([{'role': 'user', 'content': 'Offline fixture'}], max_tokens=256)
+    try:
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            future = executor.submit(run)
+            assert entered.wait(2)
+            before = service.usage()
+            assert before['unverifiedReservedTokens'] > 12
+            research.stop_research_owner(fence)
+            release.set()
+            with pytest.raises(research.ResearchError, match='research_owner_stopped'):
+                future.result(timeout=3)
+        assert service.usage()['committedTokens'] == before['committedTokens']
+        assert service.usage()['verifiedTokens'] == 0
+        assert service.get(request_id)['modelOutputs'] == []
+        with pytest.raises(research.ResearchError, match='research_owner_stopped'):
+            service.source_call(request_id)
+        next_owner = research.start_research_owner()
+        try:
+            replacement = research.AssistantResearchService(service.database, limits=service.limits,
+                                                            config=service.config, owner=next_owner)
+            assert replacement.recover_interrupted() == 1
+            assert replacement.get(request_id)['status'] == 'interrupted'
+            assert replacement.usage()['committedTokens'] == before['committedTokens']
+            with pytest.raises(research.ResearchError, match='research_owner_stopped'):
+                service.fail(request_id, 'late_old_worker')
+        finally:
+            research.stop_research_owner(next_owner)
+    finally:
