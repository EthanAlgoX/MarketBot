+@router.post('/commands/{command_type}')
+def financial_command(command_type: str, body: dict, context: Bridge):
+    from src.services import assistant_simulation
+    from src.services import assistant_manual_portfolio
+    if command_type in assistant_manual_portfolio.COMMAND_TYPES:
+        call(assistant_manual_portfolio.check_size, body)
+    schema = (WatchlistCommand if command_type in {'watchlist.add', 'watchlist.remove'} else
+              SimulationCreateCommand if command_type == 'simulation.create' else
+              ResearchCommand if command_type == 'research.create' else
+              ScreeningCommand if command_type == 'screening.create' else
+              ManualAccountCommand if command_type == 'portfolio.account.create' else
+              ManualCashCommand if command_type == 'portfolio.cash.record' else
+              ManualImportCommand if command_type == 'portfolio.trades.import' else
+              SimulationControlCommand if command_type in assistant_simulation.COMMAND_TYPES else None)
+    if schema is None:
+        raise HTTPException(422, detail={'error': 'command_type_unsupported'})
+    try:
+        payload = schema.model_validate(body).model_dump()
+    except ValidationError as exc:
+        raise HTTPException(422, detail=exc.errors(include_context=False, include_input=False)) from exc
+    key = payload.pop('idempotencyKey')
+    if command_type in {'research.create', 'screening.create'}:
+        from src.services.assistant_research import submit_research_request
+        return call(submit_research_request, context.service, context.database, context.issuer,
+                    context.subject, command_type, key, payload)
+    execute = (execute_watchlist if command_type.startswith('watchlist.') else
+               assistant_manual_portfolio.execute if command_type in assistant_manual_portfolio.COMMAND_TYPES else
+               assistant_simulation.execute)
+    return call(execute, context.database, command_type, key, payload)
+
+
+@router.get('/commands/{idempotency_key}')
+def command_status(idempotency_key: str, context: Bridge,
+                   commandType: str):
+    if commandType in {'research.create', 'screening.create'}:
+        from src.services.assistant_research import AssistantResearchService
+        return call(lambda: AssistantResearchService(context.database).by_key(commandType, idempotency_key))
+    return call(get_command, context.database, commandType, idempotency_key)
+
+
+@router.get('/simulation/catalog')
+def simulation_catalog(context: Bridge):
+    from src.services.assistant_simulation import catalog
+    return catalog()
