+def test_legacy_sqlite_amount_storage_is_not_a_lossless_decimal_ledger(ledger):
+    service, run_id = ledger
+    exact = Decimal('100000000.00000002')
+    with service.db.session_scope() as session:
+        portfolio = session.get(SimulationPortfolioRunRecord, run_id)
+        session.get(SimulationAccountRecord, portfolio.account_id).cash_balance = exact
+    with service.db.get_session() as session:
+        portfolio = session.get(SimulationPortfolioRunRecord, run_id)
+        stored = session.get(SimulationAccountRecord, portfolio.account_id).cash_balance
+    assert Decimal(str(stored)) != exact
+    # This is evidence for the pending durable-storage release gate, not an
+    # arithmetic regression that the assistant is permitted to hide or round.
