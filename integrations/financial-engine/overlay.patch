+def test_simulation_command_receipt_failure_rolls_back_account_creation(simulation):
+    client, _, database = simulation
+    def reject_receipt(connection, cursor, statement, parameters, context, executemany):
+        if statement.startswith('INSERT INTO assistant_finance_commands'):
+            raise RuntimeError('Synthetic command receipt failure')
+    event.listen(database._engine, 'before_cursor_execute', reject_receipt)
+    try:
+        with pytest.raises(RuntimeError, match='Synthetic'):
+            create_run(client)
+    finally:
+        event.remove(database._engine, 'before_cursor_execute', reject_receipt)
+    with workspace_scope(database), database.get_session() as session:
+        assert session.scalar(select(SimulationPortfolioRunRecord)) is None
+        assert session.scalar(select(SimulationAccountRecord)) is None
+    create_run(client)
+
