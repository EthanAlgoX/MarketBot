+"""Durable, prepaid research execution for a trusted assistant workspace.
+
+This module does not authenticate HTTP callers or choose a workspace from input.
+The bridge supplies its authenticated binding. No report is synthesized here:
+execution uses the existing analysis/screening services and verifies their saved
+result references. Model usage without verifiable accounting stays reserved.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from copy import deepcopy
+from dataclasses import dataclass
+from datetime import datetime, timezone
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+from queue import Queue
+import re
+import threading
+import time
+from uuid import uuid4
+
+from sqlalchemy import Boolean, Column, DateTime, Integer, String, Text, UniqueConstraint, func, inspect, select, text
+from sqlalchemy.orm import declarative_base
+
+from src.storage import AnalysisHistory
+from src.workspace_scope import check_database_scope, suspend_workspace_scope, workspace_scope
+
+_Base = declarative_base()
+_SCHEMA_LOCK = threading.RLock()
+_MODEL_SLOTS = threading.BoundedSemaphore(2)
+_SOURCE_SLOTS = threading.BoundedSemaphore(4)
+_OWNER_LOCK = threading.RLock()
+_OWNER = None
+_EXECUTION = ContextVar('assistant_research_execution', default=None)
+COMMAND_TYPES = ('research.create', 'screening.create')
+ACTIVE = ('queued', 'running')
+_DEPENDENCIES = ('litellm', 'tiktoken', 'schedule', 'exchange_calendars',
+                 'json_repair', 'pypinyin', 'akshare', 'efinance', 'yfinance')
+
+
+class ResearchError(Exception):
+    """Stable public error codes; never expose provider errors or credentials."""
+
+    def __init__(self, code, status=409):
+        self.code, self.status = code, status
+        super().__init__(code)
+
+
+@dataclass
+class ResearchOwnerFence:
+    epoch: str
+    active: bool = True
+
+    def recheck(self):
+        with _OWNER_LOCK:
+            if not self.active or _OWNER is not self:
+                raise ResearchError('research_owner_stopped', 503)
+
+
+def start_research_owner():
+    """Call only after the bridge acquired its cross-process exclusive owner lock."""
+    global _OWNER
+    with _OWNER_LOCK:
+        if _OWNER is not None and _OWNER.active:
+            raise ResearchError('research_owner_already_running', 503)
+        _OWNER = ResearchOwnerFence(uuid4().hex)
+        return _OWNER
+
+
+def stop_research_owner(owner):
+    """Fence late queue/SDK threads before the process owner lock is released."""
+    global _OWNER
+    with _OWNER_LOCK:
+        owner.active = False
+        if _OWNER is owner:
+            _OWNER = None
+
+
+@contextmanager
+def _owner_write(owner):
+    if owner is None:
+        # Explicit, independent offline ledger tests are not managed runtimes.
+        yield
+        return
+    with _OWNER_LOCK:
+        owner.recheck()
+        yield
+
+
+@contextmanager
+def research_write_fence():
+    """Original financial persistence hook for the inherited research execution."""
+    context = _EXECUTION.get()
+    with _owner_write(context.service.owner if context else None):
+        yield
+
+
+def _integer(value, label, maximum=10_000_000):
+    if type(value) is not int or not 0 < value <= maximum:
+        raise ResearchError('research_' + label + '_invalid', 422)
+    return value
+
+
+def _env_int(name, fallback, maximum=10_000_000):
+    try:
+        return _integer(int(os.getenv(name, str(fallback))), 'policy', maximum)
+    except (ValueError, ResearchError):
+        raise ResearchError('research_policy_invalid', 503) from None
+
+
+@dataclass(frozen=True)
+class ResearchLimits:
+    enabled: bool = False
+    request_tokens: int = 20_000
+    daily_tokens: int = 100_000
+    max_output_tokens: int = 2048
+    max_active_requests: int = 2
+    max_source_calls: int = 20
+    request_timeout_seconds: int = 120
+    source_timeout_seconds: int = 15
+
+    def __post_init__(self):
+        if type(self.enabled) is not bool:
+            raise ResearchError('research_policy_invalid', 503)
+        for field in ('request_tokens', 'daily_tokens', 'max_output_tokens',
+                      'max_active_requests', 'max_source_calls',
+                      'request_timeout_seconds', 'source_timeout_seconds'):
+            _integer(getattr(self, field), 'policy')
+        if self.max_output_tokens > 4096 or self.max_active_requests > 3:
+            raise ResearchError('research_policy_invalid', 503)
+
+    @classmethod
+    def from_env(cls):
+        return cls(
+            enabled=os.getenv('ASSISTANT_RESEARCH_ENABLED', 'false').lower() == 'true',
+            request_tokens=_env_int('ASSISTANT_RESEARCH_REQUEST_TOKEN_LIMIT', 20_000),
+            daily_tokens=_env_int('ASSISTANT_RESEARCH_DAILY_TOKEN_LIMIT', 100_000),
+            max_output_tokens=_env_int('ASSISTANT_RESEARCH_MAX_OUTPUT_TOKENS', 2048, 4096),
+            max_active_requests=_env_int('ASSISTANT_RESEARCH_MAX_ACTIVE_REQUESTS', 2, 3),
+            max_source_calls=_env_int('ASSISTANT_RESEARCH_MAX_SOURCE_CALLS', 20, 100),
+            request_timeout_seconds=_env_int('ASSISTANT_RESEARCH_TIMEOUT_SECONDS', 120, 600),
+            source_timeout_seconds=_env_int('ASSISTANT_RESEARCH_SOURCE_TIMEOUT_SECONDS', 15, 60),
+        )
+
+
+class ResearchRequest(_Base):
+    __tablename__ = 'assistant_research_requests'
+    id = Column(String(32), primary_key=True)
