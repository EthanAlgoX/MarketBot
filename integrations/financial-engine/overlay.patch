+"""Canonical daily simulation ledger stored alongside its legacy Float views.
+
+These are declared simulation rules, not an exchange's live order filters.
+Only decimal_v1 accounts may be controlled through the assistant boundary.
+"""
+from decimal import Decimal, InvalidOperation, ROUND_CEILING, ROUND_FLOOR, ROUND_HALF_EVEN
+
+PRECISION = 'decimal_v1'
+
+
+def amount(value):
+    if isinstance(value, bool):
+        raise ValueError('Boolean is not a financial amount')
+    try:
+        result = Decimal(str(value))
+    except (InvalidOperation, ValueError) as exc:
+        raise ValueError('Invalid financial amount') from exc
+    if not result.is_finite() or abs(result) > Decimal('1e15'):
+        raise ValueError('Invalid financial amount')
+    return result
+
+
+def fixed(value):
+    value = amount(value)
+    return '0' if value == 0 else format(value, 'f')
+
+
+def strings(value):
+    if isinstance(value, Decimal):
+        return fixed(value)
+    if isinstance(value, dict):
+        return {key: strings(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [strings(item) for item in value]
+    return value
+
+
+def rules(config):
+    policy = config['decimalRules']
+    if policy.get('version') != PRECISION:
+        raise ValueError('Unsupported canonical ledger version')
+    result = {key: amount(policy[key]) for key in (
+        'quantityStep', 'priceTick', 'quoteStep', 'commissionRate', 'sellTaxRate', 'slippageRate')}
+    if any(result[key] <= 0 for key in ('quantityStep', 'priceTick', 'quoteStep')):
+        raise ValueError('Financial quantization steps must be positive')
+    if any(not 0 <= result[key] < 1 for key in ('commissionRate', 'sellTaxRate', 'slippageRate')):
+        raise ValueError('Invalid financial cost rate')
+    return result
+
+
+def freeze(config):
+    if config['market'] not in {'CN', 'CRYPTO'}:
+        raise ValueError('Canonical assistant simulations support CN and crypto')
+    policy = dict(version=PRECISION,
+        quantityStep=fixed(config['lotSize']), priceTick='0.01' if config['market'] == 'CN' else '0.00000001',
+        quoteStep='0.01' if config['market'] == 'CN' else '0.00000001',
+        commissionRate=fixed(config['commissionRate']), sellTaxRate=fixed(config['sellTaxRate']),
+        slippageRate=fixed(config['slippageRate']),
+        fillRounding='adverse', grossRounding='adverse', feeRounding='ceiling',
+        valuationRounding='half_even', costBasis='proportional_total_cost',
+        source='declared_simulation_rules')
+    result = dict(config, ledgerPrecision=PRECISION, decimalRules=policy,
+                  initialCashDecimal=fixed(config['initialCash']))
+    rules(result)
+    return result
+
+
+def quantize(value, step, rounding=ROUND_HALF_EVEN):
+    return (value / step).to_integral_value(rounding=rounding) * step
+
+
+def initial_state(config):
+    policy = rules(config)
+    cash = amount(config['initialCashDecimal'])
+    if cash <= 0 or quantize(cash, policy['quoteStep']) != cash:
+        raise ValueError('Initial cash must match the quote precision')
+    return dict(cash=float(cash), equity=float(cash), positions={}, pending=None,
+                decimalLedger=dict(version=PRECISION, cash=fixed(cash), equity=fixed(cash), positions={}))
+
+
+def read_state(config, state):
+    if config.get('ledgerPrecision') != PRECISION:
+        return None
+    ledger = state.get('decimalLedger')
+    if not ledger or ledger.get('version') != PRECISION:
+        raise ValueError('Canonical financial ledger is missing; legacy values cannot reconstruct it')
+    positions = {code: dict(quantity=amount(position['quantity']),
+                            averageCost=amount(position['averageCost']),
+                            totalCost=amount(position['totalCost']))
+                 for code, position in ledger['positions'].items()}
+    if any(p['quantity'] <= 0 or p['totalCost'] < 0 for p in positions.values()):
+        raise ValueError('Invalid canonical position')
+    policy = rules(config)
+    cash, equity = amount(ledger['cash']), amount(ledger['equity'])
+    if cash < 0 or equity <= 0 or quantize(cash, policy['quoteStep']) != cash:
+        raise ValueError('Invalid canonical cash')
+    for position in positions.values():
+        if (quantize(position['quantity'], policy['quantityStep']) != position['quantity']
+                or quantize(position['totalCost'], policy['quoteStep']) != position['totalCost']):
+            raise ValueError('Invalid canonical position precision')
+        # Total cost is authoritative; average cost is only its derived view.
+        position['averageCost'] = position['totalCost'] / position['quantity']
+    return dict(cash=cash, equity=equity, positions=positions)
+
+
+def fill_cost(raw, quantity, side, policy):
+    fill = raw * (1 + policy['slippageRate'] * (1 if side == 'buy' else -1))
+    fill = quantize(fill, policy['priceTick'], ROUND_CEILING if side == 'buy' else ROUND_FLOOR)
+    if fill <= 0:
+        raise ValueError('Simulated fill price is not positive')
+    gross = quantize(quantity * fill, policy['quoteStep'], ROUND_CEILING if side == 'buy' else ROUND_FLOOR)
+    fee = quantize(gross * (policy['commissionRate'] + (policy['sellTaxRate'] if side == 'sell' else 0)),
+                   policy['quoteStep'], ROUND_CEILING)
+    return fill, gross, fee
+
+
+def affordable(raw, wanted, budget, policy):
+    """Integer-step binary search includes upward rounding of gross and fees."""
+    low, high = 0, max(0, int((wanted / policy['quantityStep']).to_integral_value(rounding=ROUND_FLOOR)))
+    while low < high:
+        middle = (low + high + 1) // 2
+        _, gross, fee = fill_cost(raw, middle * policy['quantityStep'], 'buy', policy)
+        if gross + fee <= budget:
+            low = middle
+        else:
+            high = middle - 1
+    return low * policy['quantityStep']
