+def manual_import_preview(body: dict, context: Bridge):
+    from src.services.assistant_manual_portfolio import check_size, preview
+    call(check_size, body)
+    try:
+        payload = ManualImportPreview.model_validate(body).model_dump()
+    except ValidationError as exc:
+        raise HTTPException(422, detail=exc.errors(include_context=False, include_input=False)) from exc
+    return call(preview, context.database, payload)
