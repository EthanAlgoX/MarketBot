+def test_shutdown_waits_for_original_outer_transaction_then_releases_owner(stores):
+    async def run():
+        app = FastAPI()
+        async with lifespan(app):
+            owner = app.state.assistant_process_owner
+            service = research_service(stores, owner=owner.research_owner)
+            request_id = create(stores, service)
+            binding = research.ResearchBinding(stores[0], 'lifecycle-test', 'alice', service.database)
+            entered, release, stopping = Event(), Event(), Event()
+
+            def original_write():
+                with research.research_execution_scope(service, binding, request_id):
+                    with service.database.session_scope() as session:
+                        session.add(AnalysisHistory(code='BTCUSDT', query_id='active-commit'))
+                        session.flush()
+                        entered.set()
+                        assert release.wait(5)
+
+            def stop_owner():
+                stopping.set()
+                owner.fence()
+
+            with ThreadPoolExecutor(max_workers=2) as workers:
+                active = workers.submit(original_write)
+                assert entered.wait(5)
+                shutdown = workers.submit(stop_owner)
+                assert stopping.wait(5)
+                assert not shutdown.done()
+                release.set()
+                active.result(timeout=5)
+                shutdown.result(timeout=5)
+            with workspace_scope(service.database), service.database.get_session() as session:
+                assert session.scalar(select(func.count()).select_from(AnalysisHistory)) == 1
+
+    asyncio.run(run())
