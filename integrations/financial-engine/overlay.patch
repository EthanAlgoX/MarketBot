+def test_timed_out_provider_keeps_its_slot_and_inherits_bounded_transport(stores, monkeypatch):
+    from threading import BoundedSemaphore, Event
+    service, binding = setup(stores, monkeypatch, source_timeout_seconds=1)
+    request_id = running(service, binding)
+    slots = BoundedSemaphore(1)
+    monkeypatch.setattr(research, '_SOURCE_SLOTS', slots)
+    entered, release, finished = Event(), Event(), Event()
+    observed = []
+    def provider():
+        observed.append(research.research_transport_timeout(12))
+        entered.set()
+        release.wait(3)
+        finished.set()
+        return 'late offline fixture'
+    try:
+        with research.research_execution_scope(service, binding, request_id):
+            with pytest.raises(research.ResearchError, match='research_source_timeout'):
+                research.call_research_source(provider)
+        assert entered.is_set()
+        assert observed and 0 < observed[0] <= 1
+        assert not slots.acquire(blocking=False), 'Timed-out network operation released its slot too soon'
+        assert service.usage()['modelCalls'] == 0
+    finally:
+        release.set()
+        assert finished.wait(2)
+        for _ in range(100):
+            if slots.acquire(blocking=False):
+                slots.release()
+                break
+            time.sleep(.01)
+        else:
+            pytest.fail('Completed provider did not return its slot')
