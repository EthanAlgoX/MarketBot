index 0000000..f57065b
--- /dev/null
+++ b/src/services/assistant_bridge_service.py
@@ -0,0 +1,402 @@
+"""Private assistant bridge; operator bindings are the only workspace selector.
+
+GET methods only read persisted financial records. They never refresh quotes,
+invoke a model, replay an account, or advance a simulation.
+"""
+
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal, InvalidOperation
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import threading
+from uuid import uuid4
+
+from sqlalchemy import func, select
+from sqlalchemy.dialects.sqlite import insert as sqlite_insert
+
+from src.storage import (
+    AnalysisHistory, AssistantBridgeBindingRecord, AssistantBridgeEventRecord,
+    AssistantBridgeStreamRecord, DatabaseManager, PortfolioAccount,
+    PortfolioDailySnapshot, SimulationAccountRecord,
+    SimulationEquitySnapshotRecord, SimulationPortfolioRunRecord, SimulationRunRecord,
+)
+from src.workspace_scope import current_workspace_database, workspace_scope
+
+MAX_SAFE_SEQUENCE = 9007199254740991
+_STORES = {}
+_STORE_LOCK = threading.RLock()
+
+
+class BridgeError(Exception):
+    def __init__(self, code, status):
+        super().__init__(code)
+        self.code, self.status = code, status
+
+
+def decimal_string(value):
+    """Fixed notation preserves legacy values without inventing extra precision."""
+    if value is None:
+        return None
+    try:
+        amount = Decimal(str(value))
+    except (InvalidOperation, ValueError):
+        return None
+    if not amount.is_finite():
+        return None
+    if amount == 0:
+        return '0'
+    return format(amount, 'f')
+
+
+def utc_iso(value, *, known_utc=False):
+    if value is None:
+        return None
+    if value.tzinfo is None:
+        # Legacy report timestamps were written with datetime.now(). Their
+        # timezone is unknown, so they must not be relabelled as UTC.
+        if not known_utc:
+            return None
+        value = value.replace(tzinfo=timezone.utc)
+    return value.astimezone(timezone.utc).isoformat().replace('+00:00', 'Z')
+
+
+def asset(symbol, market='', currency='', name=''):
+    symbol = str(symbol or '')
+    market = str(market or '').lower()
+    if not market:
+        market = ('crypto' if symbol.upper().endswith(('USDT', '-USD', '/USD'))
+                  else 'cn' if re.fullmatch(r'(?:(?:SH|SZ|BJ)[.]?\d{6}|\d{6}(?:[.](?:SH|SS|SZ|BJ))?)', symbol, re.I)
+                  else 'hk' if symbol.lower().startswith('hk') or re.fullmatch(r'\d{5}|\d{1,5}[.]HK', symbol, re.I)
+                  else 'us')
+    currency = str(currency or {'cn': 'CNY', 'hk': 'HKD', 'us': 'USD', 'crypto': 'USDT',
+                                'tw': 'TWD', 'jp': 'JPY', 'kr': 'KRW'}.get(market, ''))
+    return dict(assetId=f'{market}:{symbol}', symbol=symbol, name=str(name or ''), market=market, currency=currency)
+
+
+class AssistantBridgeService:
+    def __init__(self, control_db=None):
+        if current_workspace_database() is not None:
+            raise BridgeError('control_plane_scope_required', 503)
+        self.control_db = control_db or DatabaseManager.get_instance()
+
+    def authenticate(self, authorization, issuer, subject):
+        issuer, subject = self.authenticate_identity(authorization, issuer, subject)
+        return self.resolve(issuer, subject)
+
+    @staticmethod
+    def authenticate_identity(authorization, issuer, subject):
+        token = os.getenv('FINANCIAL_BRIDGE_TOKEN', '')
+        configured_issuer = os.getenv('FINANCIAL_BRIDGE_ISSUER', '').strip()
+        if len(token) < 32 or not configured_issuer or len(configured_issuer) > 128:
+            raise BridgeError('bridge_unconfigured', 503)
+        expected = 'Bearer ' + token
+        if not authorization or not secrets.compare_digest(authorization.encode(), expected.encode()):
+            raise BridgeError('bridge_unauthorized', 401)
+        if issuer != configured_issuer:
+            raise BridgeError('bridge_issuer_rejected', 403)
+        if not subject or not subject.strip() or len(subject) > 256:
+            raise BridgeError('bridge_identity_unbound', 403)
+        return configured_issuer, subject
+
+    def resolve(self, issuer, subject):
+        with self.control_db.get_session() as session:
+            row = session.scalar(select(AssistantBridgeBindingRecord).where(
+                AssistantBridgeBindingRecord.issuer == issuer,
+                AssistantBridgeBindingRecord.subject == subject,
+                AssistantBridgeBindingRecord.enabled.is_(True),
+            ))
+            if row is None:
+                raise BridgeError('bridge_identity_unbound', 403)
+            workspace_id = row.workspace_id
+        return self.database(workspace_id)
+
+    def database(self, workspace_id, *, provision=False):
+        if not re.fullmatch(r'[a-f0-9]{32}', workspace_id):
+            raise BridgeError('bridge_storage_invalid', 503)
+        url = self.control_db._engine.url
+        if url.get_backend_name() != 'sqlite' or url.database in (None, '', ':memory:'):
+            raise BridgeError('bridge_storage_unsupported', 503)
+        root = Path(url.database).resolve().parent
+        directory = root / 'assistant-workspaces' / workspace_id
+        for path in (root / 'assistant-workspaces', directory):
+            if path.is_symlink():
+                raise BridgeError('bridge_storage_invalid', 503)
+            if provision:
+                path.mkdir(mode=0o700, parents=True, exist_ok=True)
+        path = directory / 'workspace.db'
+        if path.is_symlink():
+            raise BridgeError('bridge_storage_invalid', 503)
+        if not provision and not path.is_file():
+            raise BridgeError('bridge_workspace_missing', 503)
+        key = str(path)
+        with _STORE_LOCK:
+            if key not in _STORES:
+                if len(_STORES) >= 256:
+                    raise BridgeError('bridge_workspace_capacity', 503)
+                _STORES[key] = DatabaseManager.open_workspace('sqlite:///' + key, workspace_id)
+            return _STORES[key]
+
+    def bind(self, issuer, subject, *, enabled=True, allow_reenable=True):
+        """Create one stable identity binding; existing storage is never rebuilt.
+
+        Only the local operator can enable a disabled mapping. The private
+        self-binding endpoint uses allow_reenable=False and trusted headers.
+        """
+        if not issuer.strip() or len(issuer) > 128 or not subject.strip() or len(subject) > 256:
+            raise ValueError('issuer and subject must be nonempty bounded strings')
+        with self.control_db.session_scope() as session:
+            # The first write serializes concurrent first-time setup before
+            # either caller reads an existing identity mapping.
+            inserted = session.execute(sqlite_insert(AssistantBridgeBindingRecord).values(
+                issuer=issuer, subject=subject, workspace_id=uuid4().hex, enabled=enabled,
+            ).on_conflict_do_nothing(index_elements=['issuer', 'subject'])).rowcount
+            row = session.scalar(select(AssistantBridgeBindingRecord).where(
+                AssistantBridgeBindingRecord.issuer == issuer, AssistantBridgeBindingRecord.subject == subject))
+            newly_created = inserted == 1
+            if not row.enabled and enabled and not allow_reenable:
+                raise BridgeError('bridge_identity_unbound', 403)
+            row.enabled = enabled
+            session.flush()
+            workspace_id = row.workspace_id
+            # Publish the control mapping only after its new, empty workspace
+            # and stream exist. Existing mappings must retain their stream ID.
+            db = self.database(workspace_id, provision=newly_created)
+            with workspace_scope(db), db.session_scope() as workspace_session:
+                stream = workspace_session.get(AssistantBridgeStreamRecord, 1)
+                if stream is None:
+                    if not newly_created:
+                        raise BridgeError('bridge_stream_uninitialized', 503)
+                    workspace_session.add(AssistantBridgeStreamRecord(id=1, stream_id=uuid4().hex))
+            from src.services.assistant_research import initialize_research_database
+            initialize_research_database(db)
+        return dict(issuer=issuer, subject=subject, workspaceId=workspace_id, enabled=enabled)
+
+    def connect(self, issuer, subject):
+        self.bind(issuer, subject, allow_reenable=False)
+        return dict(status='ready')
+
+    def disable(self, issuer, subject):
+        """Local revocation never depends on the workspace file still existing."""
+        with self.control_db.session_scope() as session:
+            row = session.scalar(select(AssistantBridgeBindingRecord).where(
+                AssistantBridgeBindingRecord.issuer == issuer, AssistantBridgeBindingRecord.subject == subject))
+            if row is None:
+                raise BridgeError('bridge_identity_unbound', 403)
+            row.enabled = False
+            return dict(issuer=issuer, subject=subject, workspaceId=row.workspace_id, enabled=False)
+
+    @staticmethod
+    def _stream(session):
+        stream = session.get(AssistantBridgeStreamRecord, 1)
+        if stream is None:
+            raise BridgeError('bridge_stream_uninitialized', 503)
+        high_water = session.scalar(select(func.max(AssistantBridgeEventRecord.sequence))) or 0
+        if high_water > MAX_SAFE_SEQUENCE:
+            raise BridgeError('bridge_sequence_overflow', 503)
+        return stream.stream_id, high_water
+
+    @staticmethod
+    def append_event(session, kind, payload, *, simulation_date=None, execution_precision=None):
+        """Use the caller's financial transaction; never commit separately here."""
+        row = AssistantBridgeEventRecord(event_id=uuid4().hex, kind=kind,
+            payload_json=json.dumps(payload, ensure_ascii=False, allow_nan=False),
+            simulation_date=simulation_date, execution_precision=execution_precision)
+        session.add(row)
+        session.flush()
+        return dict(id=row.event_id, sequence=row.sequence)
+
+    def emit_test(self, issuer, subject, message):
+        db = self.resolve(issuer, subject)
+        with workspace_scope(db), db.session_scope() as session:
+            self._stream(session)
+            return self.append_event(session, 'integration.test', dict(message=message, synthetic=True))
+
+    def events(self, db, after=0, limit=100):
+        with workspace_scope(db), db.get_session() as session:
+            stream_id, high_water = self._stream(session)
+            if after > high_water:
+                raise BridgeError('bridge_cursor_ahead', 409)
+            rows = session.scalars(select(AssistantBridgeEventRecord).where(
+                AssistantBridgeEventRecord.sequence > after,
+                AssistantBridgeEventRecord.sequence <= high_water,
+            ).order_by(AssistantBridgeEventRecord.sequence).limit(limit))
+            return dict(streamId=stream_id, highWater=high_water, after=after, events=[dict(
+                id=row.event_id, sequence=row.sequence, kind=row.kind,
+                recordedAt=utc_iso(row.recorded_at, known_utc=True), simulationDate=row.simulation_date,
+                executionPrecision=row.execution_precision, payload=json.loads(row.payload_json),
+            ) for row in rows])
+
+    @staticmethod
+    def _reports(session, offset=0, limit=20):
+        rows = session.scalars(select(AnalysisHistory).order_by(
+            AnalysisHistory.id.desc()).offset(offset).limit(limit))
+        return [dict(id=row.id, assetId=asset(row.code)['assetId'], symbol=row.code,
+            name=row.name or '', createdAt=utc_iso(row.created_at), summary=row.analysis_summary or '',
+            advice=row.operation_advice, quality='available' if row.analysis_summary else 'missing') for row in rows]
+
+    def reports(self, db, offset=0, limit=20):
+        with workspace_scope(db), db.get_session() as session:
+            total = session.scalar(select(func.count(AnalysisHistory.id))) or 0
+            return dict(items=self._reports(session, offset, limit), total=total, offset=offset, limit=limit)
+
+    @staticmethod
+    def _account(session, row):
+        snapshot = session.scalar(select(PortfolioDailySnapshot).where(
+            PortfolioDailySnapshot.account_id == row.id,
+            PortfolioDailySnapshot.cost_method == 'fifo',
+        ).order_by(PortfolioDailySnapshot.snapshot_date.desc()).limit(1))
+        payload = {}
+        if snapshot and snapshot.payload:
+            try:
+                payload = json.loads(snapshot.payload)
+            except json.JSONDecodeError as exc:
+                raise BridgeError('bridge_snapshot_invalid', 503) from exc
+            if not isinstance(payload, dict):
+                raise BridgeError('bridge_snapshot_invalid', 503)
+        positions = payload.get('positions')
+        complete = isinstance(positions, list) and all(isinstance(p, dict) for p in positions)
+        if not complete:
+            positions = []
+        missing_prices = not complete or any(p.get('price_available') is not True for p in positions)
+        stale_prices = payload.get('fx_stale') or any(p.get('price_stale') for p in positions)
+        quality = ('missing' if snapshot is None or missing_prices else
+                   'stale' if stale_prices or snapshot.snapshot_date < datetime.now(timezone.utc).date() - timedelta(days=3)
+                   else 'available')
+        return dict(id=row.id, name=row.name, market=row.market.lower(), currency=row.base_currency,
+            snapshotDate=snapshot.snapshot_date.isoformat() if snapshot else None, quality=quality,
+            cash=decimal_string(snapshot.total_cash) if snapshot else None,
+            equity=decimal_string(snapshot.total_equity) if snapshot and not missing_prices else None,
+            marketValue=decimal_string(snapshot.total_market_value) if snapshot and not missing_prices else None,
+            positions=[dict(assetId=asset(p.get('symbol'), p.get('market'))['assetId'], symbol=p.get('symbol', ''),
+                market=str(p.get('market', '')).lower(), currency=p.get('currency', ''),
+                quantity=decimal_string(p.get('quantity')), averageCost=decimal_string(p.get('avg_cost')),
+                lastPrice=decimal_string(p.get('last_price')) if p.get('price_available') is True else None,
+                marketValue=decimal_string(p.get('market_value_base')) if p.get('price_available') is True else None)
+                for p in positions])
+
+    @staticmethod
+    def _run(session, row):
+        config = json.loads(row.config_json)
+        state = json.loads(row.state_json)
+        ledger = state.get('decimalLedger') if config.get('ledgerPrecision') == 'decimal_v1' else None
+        if config.get('ledgerPrecision') == 'decimal_v1' and (not ledger or ledger.get('version') != 'decimal_v1'):
+            raise BridgeError('bridge_canonical_ledger_missing', 503)
+        account = session.get(SimulationAccountRecord, row.account_id)
+        equity = session.scalar(select(SimulationEquitySnapshotRecord).where(
+            SimulationEquitySnapshotRecord.account_id == row.account_id,
+        ).order_by(SimulationEquitySnapshotRecord.id.desc()).limit(1))
+        return dict(id=row.id, name=config.get('name', ''), market=config.get('market', '').lower(),
+            mode=row.mode, status=row.status, lastTradingDate=row.last_date,
+            nextCheckAt=utc_iso(row.next_check_at, known_utc=True), executionPrecision='day',
+            decisionBackend=config.get('decisionBackend', 'rules'), currency=account.currency,
+            cash=decimal_string(ledger['cash'] if ledger else account.cash_balance),
+            equity=decimal_string(ledger['equity']) if ledger else decimal_string(equity.equity) if equity else None,
+            revision=state.get('controlRevision', 0), ledgerPrecision='decimal_v1' if ledger else 'legacy_float')
+
+    def overview(self, db):
+        with workspace_scope(db), db.get_session() as session:
+            _, high_water = self._stream(session)
+            accounts = [self._account(session, row) for row in session.scalars(select(PortfolioAccount).where(
+                PortfolioAccount.is_active.is_(True)).order_by(PortfolioAccount.id))]
+            quality = ('missing' if not accounts or all(a['quality'] == 'missing' for a in accounts)
+                       else 'stale' if any(a['quality'] != 'available' for a in accounts) else 'available')
+            from src.services.assistant_finance_commands import watchlist, COMMAND_TYPES
+            from src.services.assistant_simulation import COMMAND_TYPES as SIMULATION_COMMANDS
+            from src.services.assistant_simulation_scheduler import enabled
+            preferences = watchlist(session)
+            return dict(schemaVersion='1', status='ready', asOf=utc_iso(datetime.now(timezone.utc)),
+                capabilities=dict(liveTrading=False, simulationPrecision='day', readOnly=False,
+                                  supportedCommands=list(COMMAND_TYPES) + ['portfolio.account.create',
+                                      'portfolio.cash.record', 'portfolio.trades.import'] +
+                                      (list(SIMULATION_COMMANDS) if enabled() else [])),
+                watchlist=preferences['watchlist'], watchlistRevision=preferences['revision'],
+                portfolio=dict(accounts=accounts, quality=quality),
+                reports=self._reports(session), runs=[self._run(session, row) for row in session.scalars(
+                    select(SimulationPortfolioRunRecord).where(SimulationPortfolioRunRecord.status != 'deleted')
+                    .order_by(SimulationPortfolioRunRecord.id.desc()))],
+                health=dict(schedulerOwner='financial-engine', moneyStorage='legacy_float',
+                    eventHighWater=high_water, status='degraded', precisionAudit='pending',
+                    warnings=['legacy_float_storage', 'legacy_report_timezone_unknown']))
+
+    def run_detail(self, db, run_id):
+        with workspace_scope(db), db.get_session() as session:
+            row = session.get(SimulationPortfolioRunRecord, run_id)
+            if row is None or row.status == 'deleted':
+                raise BridgeError('bridge_run_not_found', 404)
+            result = self._run(session, row)
+            rows = session.scalars(select(SimulationRunRecord).where(
+                SimulationRunRecord.strategy_version_id == row.strategy_version_id,
+                SimulationRunRecord.execution_mode == 'portfolio_day',
+                SimulationRunRecord.status == 'completed',
+            ).order_by(SimulationRunRecord.id)).all()
+            recorded_days = [json.loads(day_row.result_snapshot_json) for day_row in rows]
+            days = []
+            for day_row, day in list(zip(rows, recorded_days))[-180:]:
+                financial = day.get('decimalLedger') or day
+                inputs = json.loads(day_row.input_snapshot_json)
+                raw_stamp = day.get('recordedAt')
+                try:
+                    recorded_at = utc_iso(datetime.fromisoformat(raw_stamp.replace('Z', '+00:00'))) if raw_stamp else None
+                except (ValueError, TypeError):
+                    recorded_at = None
+                days.append(dict(recordId=day_row.id, recordedAt=recorded_at,
+                    inputSources={symbol: str(source)[:150] if isinstance(source, str) else 'unknown'
+                                  for symbol, source in inputs.get('sources', {}).items()},
+                    tradingDate=day.get('date'), cash=decimal_string(financial.get('cash')),
+                    marketValue=decimal_string(financial.get('marketValue')), equity=decimal_string(financial.get('equity')),
+                    trades=[dict(symbol=t.get('code', ''), side=t.get('side', ''), status=t.get('status', ''),
+                        quantity=decimal_string(t.get('quantity')), price=decimal_string(t.get('price')),
+                        fee=decimal_string(t.get('fee')), slippage=decimal_string(t.get('slippage')),
+                        reason=t.get('reason'), signalDate=t.get('signalDate'),
+                        orderId=t.get('orderId'), fillId=t.get('fillId')) for t in financial.get('trades', [])],
+                    holdings=[dict(symbol=h.get('code', ''), quantity=decimal_string(h.get('quantity')),
+                        averageCost=decimal_string(h.get('averageCost'))) for h in financial.get('holdings', [])]))
+            from src.services.simulation_portfolio_engine import metrics
+            config = json.loads(row.config_json)
+            calculated = metrics(recorded_days, config['initialCash'], config.get('riskFreeRate', 0),
+                                 365 if result['market'] == 'crypto' else 252)
+            result.update(days=days, metrics={key: decimal_string(value) for key, value in calculated.items()},
+                          evaluatedTradingDays=len(recorded_days), displayedTradingDays=len(days),
+                          historyTruncated=len(recorded_days) > len(days), quality='available' if days else 'missing',
+                          statisticsPrecision='derived_float', decimalRules=config.get('decimalRules'),
+                          strategyRef=dict(strategyVersionId=row.strategy_version_id,
+                              ruleId=config.get('skillSnapshot', {}).get('id'),
+                              version=str(config.get('ruleVersion') or config.get('skillSnapshot', {}).get('version') or '') or None,
+                              digest=config.get('skillSnapshot', {}).get('digest')))
+            return result
+
+    def run_inputs(self, db, run_id, record_id):
+        """Authorized persisted market evidence; never refresh or replay it."""
+        with workspace_scope(db), db.get_session() as session:
+            run = session.get(SimulationPortfolioRunRecord, run_id)
+            record = session.get(SimulationRunRecord, record_id)
+            if (run is None or run.status == 'deleted' or record is None
+                    or record.strategy_version_id != run.strategy_version_id
+                    or record.execution_mode != 'portfolio_day' or record.status != 'completed'):
+                raise BridgeError('bridge_run_not_found', 404)
+            try:
+                inputs = json.loads(record.input_snapshot_json)
+                bars = {symbol: [dict(tradingDate=bar.get('date'),
+                    open=decimal_string(bar.get('decimalOpen', bar.get('open'))),
+                    close=decimal_string(bar.get('decimalClose', bar.get('close'))),
+                    high=decimal_string(bar.get('high')), low=decimal_string(bar.get('low')),
+                    volume=decimal_string(bar.get('volume')), amount=decimal_string(bar.get('amount')),
+                    priceInputSource=bar.get('priceInputSource', 'normalized_float')) for bar in history]
+                        for symbol, history in inputs.get('bars', {}).items()}
+            except (ValueError, TypeError, AttributeError) as exc:
+                raise BridgeError('bridge_run_evidence_invalid', 503) from exc
+            return dict(runId=run_id, recordId=record_id, tradingDate=inputs.get('date'),
+                benchmarkClose=decimal_string(inputs.get('benchmarkClose')),
+                sources={symbol: value[:150] if isinstance(value, str) else 'unknown'
+                         for symbol, value in inputs.get('sources', {}).items()}, bars=bars)
+
+
+def reset_bridge_stores():
+    """Test/lifecycle cleanup, never exposed through HTTP."""
+    with _STORE_LOCK:
+        for database in _STORES.values():
+            database._engine.dispose()
+        _STORES.clear()
diff --git a/src/services/assistant_finance_commands.py b/src/services/assistant_finance_commands.py
new file mode 100644
index 0000000..dd062c4
--- /dev/null
+++ b/src/services/assistant_finance_commands.py
@@ -0,0 +1,138 @@
+"""Small synchronous commands using the existing workspace preference store."""
+
+import hashlib
+import json
+import re
+from uuid import uuid4
+
+from sqlalchemy import select
+from sqlalchemy.dialects.sqlite import insert as sqlite_insert
+
+from src.services.assistant_bridge_service import BridgeError, asset
+from src.services.stock_list_parser import parse_analysis_target
+from src.storage import (
+    AssistantBridgeStateRecord, AssistantFinanceCommandRecord,
+    AssistantWatchlistMetadataRecord, WorkspaceCapabilityPreferenceRecord,
+)
+from src.workspace_scope import workspace_scope
+
+COMMAND_TYPES = ('watchlist.add', 'watchlist.remove')
+
+
+def watchlist(session):
+    rows = session.scalars(select(WorkspaceCapabilityPreferenceRecord).where(
+        WorkspaceCapabilityPreferenceRecord.capability_kind == 'watchlist',
+        WorkspaceCapabilityPreferenceRecord.enabled.is_(True),
+    ).order_by(WorkspaceCapabilityPreferenceRecord.id))
+    items = []
+    for row in rows:
+        metadata = session.get(AssistantWatchlistMetadataRecord, row.capability_id)
+        item = asset(row.capability_id, metadata.market if metadata else '',
+                     metadata.currency if metadata else '', metadata.name if metadata else '')
+        item['reason'] = metadata.reason if metadata else ''
+        items.append(item)
+    state = session.get(AssistantBridgeStateRecord, 'watchlist_revision')
+    return dict(revision=state.value if state else 0, watchlist=items)
+
+
+def normalize_request(payload):
+    """Reuse the financial parser, retaining its stock/index distinction."""
+    symbol = payload['symbol'].strip()
+    market = payload['market']
+    if market == 'crypto':
+        symbol = symbol.upper()
+        if not symbol.endswith('USDT'):
+            symbol += 'USDT'
+        if not re.fullmatch(r'[A-Z0-9]{2,16}USDT', symbol):
+            raise BridgeError('command_asset_invalid', 422)
+        currency = 'USDT'
+    elif market == 'cn':
+        parsed = parse_analysis_target(symbol)
+        if parsed.asset_type not in {'stock', 'index'} or parsed.exchange not in {'SH', 'SZ', 'BJ'}:
+            raise BridgeError('command_asset_invalid', 422)
+        # Existing preferences use bare stock codes. Keep explicit index IDs
+        # so sh000300 (index) does not collapse into 000300 (stock).
+        symbol = parsed.canonical_id if parsed.asset_type == 'index' else parsed.normalized_code
+        currency = 'CNY'
+    else:
+        raise BridgeError('command_market_unsupported', 422)
+    return dict(symbol=symbol, market=market, currency=currency,
+                name=payload.get('name', '').strip(), reason=payload.get('reason', '').strip(),
+                expectedRevision=payload['expectedRevision'])
+
+
+def command_result(row):
+    return dict(id=row.id, commandType=row.command_type, idempotencyKey=row.idempotency_key,
+                status=row.status, result=json.loads(row.result_json))
+
+
+def get_command(database, command_type, key):
+    from src.services.assistant_simulation import COMMAND_TYPES as SIMULATION_COMMANDS
+    from src.services.assistant_manual_portfolio import COMMAND_TYPES as MANUAL_COMMANDS
+    if command_type not in COMMAND_TYPES + SIMULATION_COMMANDS + MANUAL_COMMANDS:
+        raise BridgeError('command_type_unsupported', 422)
+    with workspace_scope(database), database.get_session() as session:
+        row = session.scalar(select(AssistantFinanceCommandRecord).where(
+            AssistantFinanceCommandRecord.command_type == command_type,
+            AssistantFinanceCommandRecord.idempotency_key == key))
+        if row is None:
+            raise BridgeError('command_not_found', 404)
+        return command_result(row)
+
+
+def execute_watchlist(database, command_type, key, payload):
+    if command_type not in COMMAND_TYPES:
+        raise BridgeError('command_type_unsupported', 422)
+    request = normalize_request(payload)
+    encoded = json.dumps(request, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False)
+    request_hash = hashlib.sha256(encoded.encode()).hexdigest()
+    with workspace_scope(database), database.session_scope() as session:
+        # Acquire SQLite's one writer before checking key/revision. Concurrent
+        # identical requests cannot both observe an absent command record.
+        session.execute(sqlite_insert(AssistantBridgeStateRecord).values(key='watchlist_revision', value=0)
+                        .on_conflict_do_nothing(index_elements=['key']))
+        prior = session.scalar(select(AssistantFinanceCommandRecord).where(
+            AssistantFinanceCommandRecord.command_type == command_type,
+            AssistantFinanceCommandRecord.idempotency_key == key))
+        if prior:
+            if prior.request_hash != request_hash:
+                raise BridgeError('command_idempotency_conflict', 409)
+            return command_result(prior)
+        state = session.get(AssistantBridgeStateRecord, 'watchlist_revision')
+        if state.value != request['expectedRevision']:
+            raise BridgeError('command_revision_conflict', 409)
+        preference = session.scalar(select(WorkspaceCapabilityPreferenceRecord).where(
+            WorkspaceCapabilityPreferenceRecord.capability_kind == 'watchlist',
+            WorkspaceCapabilityPreferenceRecord.capability_id == request['symbol']))
+        metadata = session.get(AssistantWatchlistMetadataRecord, request['symbol'])
+        changed = False
+        if command_type == 'watchlist.add':
+            if preference is None:
+                preference = WorkspaceCapabilityPreferenceRecord(capability_kind='watchlist',
+                    capability_id=request['symbol'], enabled=True)
+                session.add(preference)
+                changed = True
+            elif not preference.enabled:
+                preference.enabled, changed = True, True
+            fields = {k: request[k] for k in ('market', 'currency', 'name', 'reason')}
+            if metadata is None:
+                metadata = AssistantWatchlistMetadataRecord(symbol=request['symbol'], **fields)
+                session.add(metadata)
+                changed = True
+            else:
+                for field, value in fields.items():
+                    if getattr(metadata, field) != value:
+                        setattr(metadata, field, value)
+                        changed = True
+        elif preference and preference.enabled:
+            preference.enabled, changed = False, True
+        if changed:
+            state.value += 1
+        session.flush()
+        result = watchlist(session)
+        row = AssistantFinanceCommandRecord(id=uuid4().hex, command_type=command_type,
+            idempotency_key=key, request_hash=request_hash, request_json=encoded,
+            status='applied', result_json=json.dumps(result, ensure_ascii=False, allow_nan=False))
+        session.add(row)
+        session.flush()
+        return command_result(row)
diff --git a/src/services/assistant_manual_portfolio.py b/src/services/assistant_manual_portfolio.py
new file mode 100644
index 0000000..e01e0c0
--- /dev/null
+++ b/src/services/assistant_manual_portfolio.py
@@ -0,0 +1,369 @@
+"""Manual ledger commands reuse PortfolioAccount/Trade/CashLedger, never simulation."""
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import hashlib
+import json
+import re
+from pathlib import Path
+from types import SimpleNamespace
+from uuid import uuid4
+
+from sqlalchemy import func, select
+
+from src.repositories.portfolio_repo import PortfolioRepository
+from src.services.assistant_bridge_service import BridgeError, asset, decimal_string, utc_iso
+from src.services.assistant_finance_commands import command_result, normalize_request
+from src.services.portfolio_service import PortfolioService, PortfolioOversellError
+from src.services.stock_list_parser import parse_analysis_target
+from src.storage import (AssistantFinanceCommandRecord, AssistantManualPortfolioRecord,
+    AssistantManualTradeSourceRecord, PortfolioAccount, PortfolioTrade, PortfolioCashLedger,
+    PortfolioCorporateAction, utc_naive_now)
+from src.workspace_scope import workspace_scope
+
+COMMAND_TYPES = ('portfolio.account.create', 'portfolio.cash.record', 'portfolio.trades.import')
+MAX_BODY_BYTES = 512 * 1024
+WARNINGS = ['manual_ledger_legacy_float', 'available_cash_unverified', 'valuation_not_loaded']
+
+
+def encode(value):
+    return json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(',', ':'), allow_nan=False)
+
+
+def digest(value):
+    return hashlib.sha256(encode(value).encode()).hexdigest()
+
+
+def check_size(body):
+    try:
+        size = len(encode(body).encode())
+    except (ValueError, TypeError):
+        raise BridgeError('portfolio_request_invalid', 422) from None
+    if size > MAX_BODY_BYTES:
+        raise BridgeError('portfolio_body_too_large', 413)
+
+
+def check_database(database):
+    if not getattr(database, '_workspace_id', None) or database._engine.url.get_backend_name() != 'sqlite':
+        raise BridgeError('portfolio_workspace_required', 503)
+    path = Path(database._engine.url.database)
+    if path.is_symlink() or not path.is_file():
+        raise BridgeError('bridge_workspace_missing', 503)
+
+
+def amount(text, *, positive=True, integer=False):
+    if not isinstance(text, str) or not re.fullmatch(r'(?:0|[1-9][0-9]{0,14})(?:\.[0-9]{1,16})?', text):
+        raise BridgeError('portfolio_decimal_invalid', 422)
+    try:
+        value = Decimal(text)
+    except InvalidOperation:
+        raise BridgeError('portfolio_decimal_invalid', 422) from None
+    if not value.is_finite() or value < 0 or (positive and value == 0) or value > 1_000_000_000:
+        raise BridgeError('portfolio_decimal_invalid', 422)
+    if integer and value != value.to_integral_value():
+        raise BridgeError('portfolio_quantity_invalid', 422)
+    # This only prevents visible input loss; SQLite Float is still approximate.
+    if Decimal(str(float(value))) != value:
+        raise BridgeError('portfolio_decimal_not_representable', 422)
+    return format(value, 'f').rstrip('0').rstrip('.') if '.' in format(value, 'f') else format(value, 'f')
+
+
+def business_day(market):
+    from zoneinfo import ZoneInfo
+    from datetime import datetime, timezone
+    return datetime.now(timezone.utc if market == 'crypto' else ZoneInfo('Asia/Shanghai')).date()
+
+
+def day(text, market):
+    try:
+        value = date.fromisoformat(text)
+    except (ValueError, TypeError):
+        raise BridgeError('portfolio_date_invalid', 422) from None
+    if value.isoformat() != text or value > business_day(market) or value < date(1970, 1, 1):
+        raise BridgeError('portfolio_date_invalid', 422)
+    return value.isoformat()
+
+
+def account_view(account, metadata):
+    return dict(id=account.id, name=account.name, market=account.market, currency=account.base_currency,
+        ledgerKind='manual', assistantCreated=True, revision=metadata.revision, ledgerPrecision='legacy_float')
+
+
+def require_account(session, account_id):
+    account = session.get(PortfolioAccount, account_id)
+    metadata = session.get(AssistantManualPortfolioRecord, account_id)
+    if (account is None or metadata is None or not account.is_active or account.market not in {'cn', 'crypto'}
+            or account.base_currency != {'cn': 'CNY', 'crypto': 'USDT'}[account.market]):
+        raise BridgeError('portfolio_account_not_found', 404)
+    return account, metadata
+
+
+def normalize_trade(record, account):
+    if record['market'] != account.market or record['currency'] != account.base_currency:
+        raise BridgeError('portfolio_asset_currency_mismatch', 422)
+    try:
+        parsed = normalize_request(dict(symbol=record['symbol'], market=record['market'], expectedRevision=0))
+    except (ValueError, KeyError):
+        raise BridgeError('portfolio_asset_invalid', 422) from None
+    if account.market == 'cn' and parse_analysis_target(record['symbol']).asset_type != 'stock':
+        raise BridgeError('portfolio_asset_invalid', 422)
+    quantity = amount(record['quantity'], integer=account.market == 'cn')
+    if Decimal(quantity) <= Decimal('0.00000001'):
+        raise BridgeError('portfolio_quantity_below_legacy_precision', 422)
+    return dict(externalId=record['externalId'].strip(), tradeDate=day(record['tradeDate'], account.market),
+        symbol=parsed['symbol'], market=account.market, currency=account.base_currency, side=record['side'],
+        quantity=quantity, price=amount(record['price']), fee=amount(record.get('fee', '0'), positive=False),
+        tax=amount(record.get('tax', '0'), positive=False), note=record.get('note', '').strip())
+
+
+def trade_view(row, source=None):
+    recorded_at = utc_iso(row.created_at, known_utc=True)
+    try:
+        known_utc = source is not None and json.loads(source.source_json).get('recordedAt') == recorded_at
+    except (ValueError, TypeError, AttributeError):
+        known_utc = False
+    return dict(id=row.id, externalId=row.trade_uid or '', tradeDate=row.trade_date.isoformat(), symbol=row.symbol,
+        market=row.market, currency=row.currency, side=row.side, quantity=decimal_string(row.quantity),
+        price=decimal_string(row.price), fee=decimal_string(row.fee), tax=decimal_string(row.tax),
+        note=row.note or '', recordedAt=recorded_at if known_utc else None)
+
+
+def cash_view(row, *, known_utc=False):
+    return dict(id=row.id, eventDate=row.event_date.isoformat(), direction='deposit' if row.direction == 'in' else 'withdraw',
+        amount=decimal_string(row.amount), currency=row.currency, note=row.note or '',
+        recordedAt=utc_iso(row.created_at, known_utc=known_utc))
+
+
+def trade_source(row):
+    source = {k: v for k, v in trade_view(row).items() if k not in {'id', 'recordedAt'}}
+    for field in ('quantity', 'price', 'fee', 'tax'):
+        text = source[field]
+        if text is None:
+            raise BridgeError('portfolio_ledger_invalid', 503)
+        source[field] = text.rstrip('0').rstrip('.') if '.' in text else text
+    return source
+
+
+def ledger_state(session, account):
+    trades = list(session.scalars(select(PortfolioTrade).where(PortfolioTrade.account_id == account.id)
+        .order_by(PortfolioTrade.trade_date, PortfolioTrade.id)))
+    cash = list(session.scalars(select(PortfolioCashLedger).where(PortfolioCashLedger.account_id == account.id)
+        .order_by(PortfolioCashLedger.event_date, PortfolioCashLedger.id)))
+    corporate = list(session.scalars(select(PortfolioCorporateAction).where(PortfolioCorporateAction.account_id == account.id)
+        .order_by(PortfolioCorporateAction.effective_date, PortfolioCorporateAction.id)))
+    # Original portfolio APIs may bypass this bridge's revision and allow
+    # cross-currency events. Never sum or replay those as one-currency manual
+    # accounts: these endpoints have no validated FX conversion policy.
+    if (any(row.currency != account.base_currency for row in cash)
+            or any(row.market != account.market or row.currency != account.base_currency
+                   for row in trades + corporate)):
+        raise BridgeError('portfolio_ledger_currency_conflict', 409)
+    signature = dict(account=dict(name=account.name, market=account.market, currency=account.base_currency),
+        trades=[trade_view(row) for row in trades], cash=[cash_view(row) for row in cash],
+        corporate=[dict(id=row.id, date=row.effective_date.isoformat(), symbol=row.symbol, market=row.market,
+            currency=row.currency, kind=row.action_type, dividend=decimal_string(row.cash_dividend_per_share),
+            split=decimal_string(row.split_ratio)) for row in corporate])
+    return trades, cash, corporate, digest(signature)
+
+
+class PreviewRepository:
+    """Read-only event adapter for the original inventory replay/oversell validator."""
+    def __init__(self, trades, corporate):
+        self.trades, self.corporate = trades, corporate
+    def list_trades_in_session(self, *, session, account_id, as_of):
+        return [row for row in self.trades if row.trade_date <= as_of]
+    def list_corporate_actions_in_session(self, *, session, account_id, as_of):
+        return [row for row in self.corporate if row.effective_date <= as_of]
+
+
+def quantities(trades, corporate, *, account, session):
+    service = PortfolioService(PreviewRepository(trades, corporate))
+    last = max([business_day(account.market)] + [row.trade_date for row in trades]
+               + [row.effective_date for row in corporate])
+    identities = sorted({(row.symbol, row.market, row.currency) for row in trades})
+    return [(key, service._calculate_available_quantity(account_id=account.id, key=key,
+                    as_of_date=last, session=session)) for key in identities]
+
+
+def preview_in_session(session, account, metadata, records):
+    trades, cash, corporate, state_hash = ledger_state(session, account)
+    existing = {row.trade_uid: row for row in trades if row.trade_uid}
+    new, seen, rows = [], {}, []
+    warnings = list(WARNINGS)
+    economics = {digest({k: v for k, v in trade_source(row).items()
+                        if k not in {'externalId', 'note'}}) for row in trades}
+    next_id = max([row.id for row in trades] + [0])
+    for index, raw in enumerate(records):
+        normalized = None
+        try:
+            normalized = normalize_trade(raw, account)
+            uid = normalized['externalId']
+            if not uid:
+                raise BridgeError('portfolio_external_id_invalid', 422)
+            hashed = digest(normalized)
+            status, error = 'insert', None
+            if uid in seen:
+                status, error = ('duplicate', None) if seen[uid] == hashed else ('conflict', 'portfolio_uid_conflict')
+            elif uid in existing:
+                row = existing[uid]
+                source = session.get(AssistantManualTradeSourceRecord, row.id)
+                authoritative = trade_source(row)
+                if source is not None and source.payload_hash == hashed and digest(authoritative) == hashed:
+                    status = 'duplicate'
+                else:
+                    status, error = 'conflict', 'portfolio_uid_conflict'
+            if status == 'insert':
+                economic = digest({k: v for k, v in normalized.items() if k not in {'externalId', 'note'}})
+                if economic in economics and 'possible_duplicate_economic_rows' not in warnings:
+                    warnings.append('possible_duplicate_economic_rows')
+                economics.add(economic)
+                next_id += 1
+                new.append(SimpleNamespace(id=next_id, symbol=normalized['symbol'], market=account.market,
+                    currency=account.base_currency, trade_date=date.fromisoformat(normalized['tradeDate']),
+                    side=normalized['side'], quantity=float(normalized['quantity'])))
+            seen[uid] = hashed
+            rows.append(dict(index=index, status=status, error=error, record=normalized))
+        except BridgeError as exc:
+            rows.append(dict(index=index, status='invalid', error=exc.code, record=None))
+    try:
+        quantities(trades + new, corporate, account=account, session=session)
+    except (PortfolioOversellError, ValueError):
+        warnings.append('portfolio_oversell')
+    can_commit = all(row['status'] in {'insert', 'duplicate'} for row in rows) and 'portfolio_oversell' not in warnings
+    preview_hash = digest(dict(accountId=account.id, revision=metadata.revision, ledger=state_hash, records=rows))
+    return dict(accountId=account.id, revision=metadata.revision, previewHash=preview_hash, canCommit=can_commit,
+        insertCount=sum(row['status'] == 'insert' for row in rows),
+        duplicateCount=sum(row['status'] == 'duplicate' for row in rows), rows=rows, warnings=warnings)
+
+
+def preview(database, payload):
+    check_size(payload)
+    check_database(database)
+    with workspace_scope(database), database.get_session() as session:
+        account, metadata = require_account(session, payload['accountId'])
+        if metadata.revision != payload['expectedRevision']:
+            raise BridgeError('command_revision_conflict', 409)
+        return preview_in_session(session, account, metadata, payload['records'])
+
+
+def list_accounts(database):
+    check_database(database)
+    with workspace_scope(database), database.get_session() as session:
+        rows = session.execute(select(PortfolioAccount, AssistantManualPortfolioRecord).join(
+            AssistantManualPortfolioRecord, PortfolioAccount.id == AssistantManualPortfolioRecord.account_id)
+            .where(PortfolioAccount.is_active.is_(True)).order_by(PortfolioAccount.id)).all()
+        return dict(accounts=[account_view(*row) for row in rows[:1000]])
+
+
+def detail(database, account_id):
+    check_database(database)
+    with workspace_scope(database), database.get_session() as session:
+        account, metadata = require_account(session, account_id)
+        trades, cash, corporate, _ = ledger_state(session, account)
+        cash_commands = session.scalars(select(AssistantFinanceCommandRecord).where(
+            AssistantFinanceCommandRecord.command_type == 'portfolio.cash.record'))
+        known_cash = {}
+        for command in cash_commands:
+            request = json.loads(command.request_json)
+            if request['accountId'] == account.id:
+                known_cash[json.loads(command.result_json)['cashEntryId']] = request
+        holdings = []
+        for (symbol, market, currency), quantity in quantities(trades, corporate, account=account, session=session):
+            if quantity > 0:
+                holdings.append(dict(asset(symbol, market, currency), quantity=decimal_string(quantity), marketValue=None))
+        cash_net = sum(float(row.amount) * (1 if row.direction == 'in' else -1) for row in cash)
+        return dict(account=account_view(account, metadata), availableCash=None, cashLedgerNet=decimal_string(cash_net),
+            holdings=holdings[:1000], trades=[trade_view(row, session.get(AssistantManualTradeSourceRecord, row.id))
+                                     for row in list(reversed(trades))[:1000]],
+            cashEntries=[cash_view(row, known_utc=(row.id in known_cash and
+                known_cash[row.id]['eventDate'] == row.event_date.isoformat() and
+                known_cash[row.id]['currency'] == row.currency and
+                ('in' if known_cash[row.id]['direction'] == 'deposit' else 'out') == row.direction and
+                Decimal(known_cash[row.id]['amount']) == Decimal(str(row.amount)) and
+                known_cash[row.id].get('note', '').strip() == (row.note or '')))
+                for row in list(reversed(cash))[:1000]],
+            historyTruncated=len(trades) > 1000 or len(cash) > 1000 or len(holdings) > 1000,
+            warnings=list(WARNINGS))
+
+
+def execute(database, command_type, key, payload):
+    if command_type not in COMMAND_TYPES:
+        raise BridgeError('command_type_unsupported', 422)
+    check_size(payload)
+    check_database(database)
+    request_hash = digest(payload)
+    repo = PortfolioRepository(database)
+    with workspace_scope(database), repo.portfolio_write_session() as session:
+        prior = session.scalar(select(AssistantFinanceCommandRecord).where(
+            AssistantFinanceCommandRecord.command_type == command_type,
+            AssistantFinanceCommandRecord.idempotency_key == key))
+        if prior:
+            if prior.request_hash != request_hash:
+                raise BridgeError('command_idempotency_conflict', 409)
+            return command_result(prior)
+        if command_type == 'portfolio.account.create':
+            count = session.scalar(select(func.count()).select_from(AssistantManualPortfolioRecord))
+            if count >= 1000:
+                raise BridgeError('portfolio_account_limit', 409)
+            if payload['currency'] != {'cn': 'CNY', 'crypto': 'USDT'}[payload['market']]:
+                raise BridgeError('portfolio_asset_currency_mismatch', 422)
+            name = payload['name'].strip()
+            if not name:
+                raise BridgeError('portfolio_account_name_invalid', 422)
+            account = PortfolioAccount(name=name, market=payload['market'], base_currency=payload['currency'],
+                owner_id=database._workspace_id, broker='manual', is_active=True, created_at=utc_naive_now(),
+                updated_at=utc_naive_now())
+            session.add(account)
+            session.flush()
+            metadata = AssistantManualPortfolioRecord(account_id=account.id, revision=0)
+            session.add(metadata)
+            session.flush()
+            result = dict(account=account_view(account, metadata))
+        else:
+            account, metadata = require_account(session, payload['accountId'])
+            if metadata.revision != payload['expectedRevision']:
+                raise BridgeError('command_revision_conflict', 409)
+            if command_type == 'portfolio.cash.record':
+                ledger_state(session, account)
+                if payload['currency'] != account.base_currency:
+                    raise BridgeError('portfolio_asset_currency_mismatch', 422)
+                cash_amount = amount(payload['amount'])
+                entry = repo.add_cash_ledger_in_session(session=session, account_id=account.id,
+                    event_date=date.fromisoformat(day(payload['eventDate'], account.market)),
+                    direction='in' if payload['direction'] == 'deposit' else 'out', amount=float(cash_amount),
+                    currency=account.base_currency, note=payload.get('note', '').strip() or None)
+                entry.created_at = utc_naive_now()
+                metadata.revision += 1
+                result = dict(accountId=account.id, revision=metadata.revision, cashEntryId=entry.id,
+                              ledgerPrecision='legacy_float')
+            else:
+                evaluated = preview_in_session(session, account, metadata, payload['records'])
+                if evaluated['previewHash'] != payload['previewHash']:
+                    raise BridgeError('portfolio_preview_changed', 409)
+                if not evaluated['canCommit']:
+                    raise BridgeError('portfolio_import_invalid', 422)
+                ids = []
+                for row in evaluated['rows']:
+                    if row['status'] != 'insert':
+                        continue
+                    record = row['record']
+                    trade = repo.add_trade_in_session(session=session, account_id=account.id,
+                        trade_uid=record['externalId'], symbol=record['symbol'], market=record['market'],
+                        currency=record['currency'], trade_date=date.fromisoformat(record['tradeDate']),
+                        side=record['side'], quantity=float(record['quantity']), price=float(record['price']),
+                        fee=float(record['fee']), tax=float(record['tax']), note=record['note'] or None,
+                        dedup_hash=digest(record))
+                    trade.created_at = utc_naive_now()
+                    session.add(AssistantManualTradeSourceRecord(trade_id=trade.id,
+                        payload_hash=digest(record), source_json=encode(dict(record=record,
+                            recordedAt=utc_iso(trade.created_at, known_utc=True)))))
+                    ids.append(trade.id)
+                if ids:
+                    metadata.revision += 1
+                result = dict(accountId=account.id, revision=metadata.revision, insertedCount=len(ids),
+                    duplicateCount=evaluated['duplicateCount'], tradeIds=ids, ledgerPrecision='legacy_float')
+        row = AssistantFinanceCommandRecord(id=uuid4().hex, command_type=command_type, idempotency_key=key,
+            request_hash=request_hash, request_json=encode(payload), status='applied', result_json=encode(result))
+        session.add(row)
+        check_database(database)
+        session.flush()
+        return command_result(row)
