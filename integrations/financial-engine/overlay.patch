+"""Explicit local administration for the assistant's financial identity boundary."""
+
+import argparse
+import json
+
+from src.config import setup_env
+from src.services.assistant_bridge_service import AssistantBridgeService
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest='operation', required=True)
+    for operation in ('bind', 'disable', 'emit-test'):
+        command = sub.add_parser(operation)
+        command.add_argument('--issuer', required=True)
+        command.add_argument('--subject', required=True)
+        if operation == 'emit-test':
+            command.add_argument('--message', default='Financial bridge integration test')
+    args = parser.parse_args()
+    setup_env()
+    service = AssistantBridgeService()
+    if args.operation == 'emit-test':
+        result = service.emit_test(args.issuer, args.subject, args.message)
+    elif args.operation == 'disable':
+        # Never create an identity during a disable operation.
+        result = service.disable(args.issuer, args.subject)
+    else:
+        result = service.bind(args.issuer, args.subject)
+    print(json.dumps(result, ensure_ascii=False))
+
+
+if __name__ == '__main__':
+    main()
