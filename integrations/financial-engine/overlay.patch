+"""Isolated bridge with one process owner for durable research and simulation."""
+
+from contextlib import asynccontextmanager
+from fastapi import FastAPI
+from api.internal.assistant_bridge import router
+from src.services.assistant_simulation_scheduler import (
+    AssistantProcessOwner, AssistantSimulationScheduler, bridge_configured, enabled,
+)
+
+
+@asynccontextmanager
+async def lifespan(app):
+    owner = AssistantProcessOwner() if bridge_configured() else None
+    scheduler = None
+    try:
+        if owner:
+            await owner.start()
+            app.state.assistant_process_owner = owner
+            if enabled():
+                scheduler = AssistantSimulationScheduler(owner=owner)
+                await scheduler.start()
+        app.state.simulation_scheduler = scheduler
+        yield
+    finally:
+        if owner:
+            owner.fence()
+        if scheduler:
+            await scheduler.stop()
+        if owner:
+            await owner.stop()
+        app.state.assistant_process_owner = None
+        app.state.simulation_scheduler = None
+
+app = FastAPI(title='Financial assistant bridge', version='1', docs_url=None, redoc_url=None, lifespan=lifespan)
+app.include_router(router)
+
+
+@app.get('/health')
+def health():
+    return {'status': 'ok', 'mode': 'assistant_bridge',
+            'processOwnerStarted': getattr(app.state, 'assistant_process_owner', None) is not None,
+            'simulationSchedulerStarted': getattr(app.state, 'simulation_scheduler', None) is not None}
