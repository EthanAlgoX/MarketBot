+        invoke = lambda: function(SimpleNamespace(), 'Offline fixture', {})
+    elif entry == 'agent':
+        function = original_function('src/agent/llm_adapter.py', 'call_completion', {
+            'resolve_agent_litellm_route': lambda config: SimpleNamespace(primary_model=config.litellm_model)})
+        adapter = SimpleNamespace(_config=service.config,
+            _convert_messages=lambda messages, **kwargs: messages)
+        invoke = lambda: function(adapter, [{'role': 'user', 'content': 'Offline fixture'}])
+    else:
+        function = original_function('src/services/screening/ranker.py', '_call_llm')
+        invoke = lambda: function('Offline fixture', 'unused', 'unused', '')
+    with research.research_execution_scope(service, binding, request_id):
