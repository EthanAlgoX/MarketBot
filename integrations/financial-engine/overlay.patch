+    service, run_id = ledger
+    monkeypatch.setattr('src.services.simulation_portfolio_service._POOL.submit', lambda *args, **kwargs: None)
+    assert service.enqueue(run_id, automatic=True)
+    assert not service.enqueue(run_id, automatic=True)
+    service.recover()
+    with service.db.get_session() as session:
+        row = session.get(SimulationPortfolioRunRecord, run_id)
+        assert row.status == 'running' and row.lease_token is None
+        assert json.loads(row.state_json)['cash'] == 1000
+        assert session.get(SimulationAccountRecord, row.account_id).cash_balance == 1000
