+    symbols = list(dict.fromkeys(normalize_request(dict(symbol=symbol, market=request['market'],
+        expectedRevision=0))['symbol'] for symbol in request['symbols']))
+    # This fixed symbol pool is user-confirmed input, not a fabricated market
+    # snapshot. The existing engine owns every rule decision and fill.
+    universe = dict(market=market, scope=dict(symbols=symbols), source='assistant_confirmed_symbols',
+                    candidates=[dict(code=symbol, name=symbol) for symbol in symbols])
+    if ((market == 'CRYPTO' and not request['ruleId'].startswith('crypto_'))
+            or (market == 'CN' and request['ruleId'] != 'high_volume_volatility_grid')):
+        raise BridgeError('simulation_rule_market_mismatch', 422)
+    if market == 'CRYPTO':
+        from src.services.crypto_portfolio_rules import skill_snapshot
+        skill = skill_snapshot(request['ruleId'])
+    else:
+        from src.agent.skills.base import SkillManager
+        manager = SkillManager()
+        manager.load_builtin_skills()
+        builtin = manager.get(request['ruleId'])
+        if builtin is None:
+            raise BridgeError('simulation_builtin_missing', 503)
+        skill = dict(id=request['ruleId'], name=builtin.display_name, version=1,
+            instructions=builtin.instructions, digest=hashlib.sha256(builtin.instructions.encode()).hexdigest())
+    amounts = {key: canonical.amount(request[key]) for key in (
+        'initialCash', 'commissionRate', 'slippageRate', 'sellTaxRate')}
+    if not 0 < amounts['initialCash'] <= canonical.amount('1000000000'):
+        raise BridgeError('simulation_cash_invalid', 422)
+    if any(not 0 <= amounts[key] <= canonical.amount('0.05') for key in amounts if key != 'initialCash'):
+        raise BridgeError('simulation_cost_invalid', 422)
+    prepared = service._prepare_config(dict(name=request['name'], market=market, mode=request['mode'],
+        template='agent', engine='agent', decisionBackend='rules', skillSnapshot=skill,
+        universe=universe, universeHistory='fixed', symbols=symbols, scopeRefresh='snapshot',
+        initialCash=float(amounts['initialCash']), commissionRate=float(amounts['commissionRate']),
+        slippageRate=float(amounts['slippageRate']), sellTaxRate=float(amounts['sellTaxRate']),
+        lotSize=0.00000001 if market == 'CRYPTO' else 100, maxWeight=0.5,
+        maxPositions=min(3, len(symbols)), riskFreeRate=0, cryptoAllocation=0.5,
+        cryptoRebalanceDays=7, cryptoLookbackDays=30, cryptoTopN=3,
+        gridLookbackDays=5, gridMinVolumeRatio=1.3, gridMinRange=0.05, gridLevels=5,
+        startDate=request.get('startDate'), endDate=request.get('endDate'),
+        reportLanguage='zh', runTokenBudget=100000, assistantControlled=True))
+    # Preserve the original decimal request through original validation; SQL
+    # Float/config numeric values remain compatibility inputs for statistics.
+    frozen = canonical.freeze(dict(prepared, **{key: canonical.fixed(value) for key, value in amounts.items()}))
+    for key in amounts:
+        frozen[key] = float(amounts[key])
+    canonical.initial_state(frozen)
+    return frozen
+
+
+def execute(database, command_type, key, request):
+    if command_type not in COMMAND_TYPES:
+        raise BridgeError('command_type_unsupported', 422)
+    if not enabled():
+        raise BridgeError('simulation_disabled', 503)
+    encoded = json.dumps(request, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False)
+    request_hash = hashlib.sha256(encoded.encode()).hexdigest()
+    with workspace_scope(database), database.session_scope() as session:
+        session.execute(sqlite_insert(AssistantBridgeStateRecord).values(key='simulation_commands', value=0)
+                        .on_conflict_do_nothing(index_elements=['key']))
+        previous = session.scalar(select(AssistantFinanceCommandRecord).where(
+            AssistantFinanceCommandRecord.command_type == command_type,
+            AssistantFinanceCommandRecord.idempotency_key == key))
+        if previous:
+            if previous.request_hash != request_hash:
+                raise BridgeError('command_idempotency_conflict', 409)
+            return command_result(previous)
+        service = SimulationPortfolioService(database)
+        try:
+            if command_type == 'simulation.create':
+                row = service.create_in_session(session, create_config(service, request))
+            else:
+                row = session.get(SimulationPortfolioRunRecord, request['runId'])
+                if row is None or row.status == 'deleted':
+                    raise BridgeError('bridge_run_not_found', 404)
+                config = json.loads(row.config_json)
+                if not config.get('assistantControlled') or config.get('ledgerPrecision') != canonical.PRECISION:
+                    raise BridgeError('simulation_legacy_readonly', 409)
+                state = json.loads(row.state_json)
+                canonical.read_state(config, state)
+                if state.get('controlRevision', 0) != request['expectedRevision']:
+                    raise BridgeError('command_revision_conflict', 409)
+                action = command_type.split('.')[1]
+                if action == 'run' and row.mode != 'backtest':
+                    raise BridgeError('simulation_run_requires_backtest', 422)
+                allowed = {'start': {'ready'}, 'pause': {'running'}, 'resume': {'paused'},
+                           'stop': {'ready', 'running', 'paused'}, 'run': {'ready'}}
+                if row.status not in allowed[action] or (action != 'run' and row.mode != 'paper' and action != 'stop'):
+                    raise BridgeError('simulation_status_conflict', 409)
+                row = service.control_in_session(session, row.id, action)
+                if action == 'run':
+                    state = json.loads(row.state_json)
+                    state['workRequested'] = True
+                    row.state_json = json.dumps(state)
+                    row.next_check_at = utc_naive_now()
+        except (ValueError, LookupError, KeyError) as exc:
+            raise BridgeError('simulation_request_invalid', 422) from exc
+        result = dict(runId=row.id, status=row.status,
+            revision=json.loads(row.state_json).get('controlRevision', 0), ledgerPrecision=canonical.PRECISION)
+        receipt = AssistantFinanceCommandRecord(id=uuid4().hex, command_type=command_type,
+            idempotency_key=key, request_hash=request_hash, request_json=encoded,
+            status='applied', result_json=json.dumps(result, allow_nan=False))
+        session.add(receipt)
+        session.flush()
+        return command_result(receipt)
