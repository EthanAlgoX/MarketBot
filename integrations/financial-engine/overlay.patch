+
+
+class ResearchDay(_Base):
+    __tablename__ = 'assistant_research_budget_days'
+    day = Column(String(10), primary_key=True)
+    blocked = Column(Boolean, nullable=False, default=False)
+    error_code = Column(String(80))
+
+
+def _now():
+    return datetime.now(timezone.utc).replace(tzinfo=None)
+
+
+def _stamp(value):
+    return value.isoformat() + 'Z' if value else None
+
+
+def _encode(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+
+def _view(row, outputs=None):
+    return dict(id=row.id, commandType=row.command_type, idempotencyKey=row.idempotency_key,
+                status=row.status, request=json.loads(row.request_json),
+                resultRef=json.loads(row.result_ref_json) if row.result_ref_json else None,
+                result=public_result(row.command_type, json.loads(row.result_json)) if row.result_json else None,
+                error={'code': row.error_code} if row.error_code else None,
+                createdAt=_stamp(row.created_at), startedAt=_stamp(row.started_at),
+                completedAt=_stamp(row.completed_at), modelOutputs=outputs or [], cost=None, currency=None)
+
+
+def _request_view(session, row):
+    calls = session.scalars(select(ResearchCall).where(
+        ResearchCall.request_id == row.id, ResearchCall.output_json.is_not(None)).order_by(
+            ResearchCall.created_at, ResearchCall.id)).all()
+    return _view(row, [dict(callId=call.id, model=call.model, status=call.status,
+                           output=json.loads(call.output_json)) for call in calls])
+
+
+def _public_value(value):
+    if isinstance(value, str):
+        from src.services.run_diagnostics import sanitize_diagnostic_text
+        # Narratives are business fields, with credentials and local paths redacted.
+        return sanitize_diagnostic_text(value, max_length=100_000)
+    if isinstance(value, list):
+        return [_public_value(item) for item in value[:100] if not isinstance(item, dict)]
+    return value if value is None or isinstance(value, (int, float, bool)) else None
+
+
+def _project(value, keys):
+    return {key: _public_value(value[key]) for key in keys if key in value} if isinstance(value, dict) else {}
+
+
+def public_result(command_type, result):
+    """Explicit business projection; the full original JSON stays in the ledger."""
+    if command_type == 'research.create':
+        output = _project(result, ('query_id', 'trace_id', 'stock_code', 'stock_name'))
+        report = result.get('report')
+        if isinstance(report, dict):
+            output['report'] = {
+                'meta': _project(report.get('meta'), ('query_id', 'trace_id', 'stock_code', 'stock_name',
+                    'report_type', 'report_language', 'current_price', 'change_pct', 'model_used')),
+                'summary': _project(report.get('summary'), ('analysis_summary', 'operation_advice',
+                    'action', 'action_label', 'trend_prediction', 'sentiment_score', 'sentiment_label')),
+                'strategy': _project(report.get('strategy'), ('ideal_buy', 'secondary_buy', 'stop_loss', 'take_profit')),
+                'details': _project(report.get('details'), ('news_summary', 'technical_analysis',
+                    'fundamental_analysis', 'risk_warning')),
+            }
+        return output
+    fields = ('enabled', 'candidate_count', 'run_id', 'strategy', 'strategy_display_name',
+              'strategy_description', 'market', 'snapshot_count', 'snapshot_source',
+              'after_filter_count', 'llm_ranked', 'llm_market_view', 'llm_selection_logic',
+              'llm_portfolio_risk', 'llm_model_used', 'llm_coverage', 'ranking_mode', 'daily_enriched',
+              'daily_enrich_count', 'deep_analysis_requested', 'post_analyzers',
+              'risk_enabled', 'portfolio_diversity_enabled', 'portfolio_concentration_notes')
+    output = _project(result, fields)
+    output['candidates'] = [_project(candidate, ('rank', 'code', 'name', 'final_score', 'screen_score',
+        'score', 'reason', 'risk_level', 'risk_flags', 'llm_confidence', 'llm_sector', 'llm_theme',
+        'llm_tags', 'llm_thesis', 'llm_catalysts', 'llm_risks', 'llm_watch_items', 'llm_invalidators',
+        'llm_score', 'ranking_reason', 'risk_summary', 'price', 'change_pct', 'amount', 'total_mv',
+        'turnover_rate', 'volume_ratio', 'pe_ratio', 'pb_ratio', 'industry', 'concepts'))
+        for candidate in (result.get('candidates') or [])[:30] if isinstance(candidate, dict)]
+    if isinstance(result.get('llm_coverage'), dict):
+        # Keep coverage counts/labels; nested diagnostic/provider structures are excluded.
+        output['llm_coverage'] = {key: _public_value(value) for key, value in result['llm_coverage'].items()
+            if key in {'mode', 'sampled', 'total', 'ranked', 'llm_input_count', 'llm_sample_size',
+                       'candidate_count', 'coverage_ratio', 'sampled_count', 'total_count',
+                       'requested_count', 'available_count', 'is_sampled'}}
+    return output
+
+
+def normalize_request(command_type, payload):
+    if command_type not in COMMAND_TYPES or not isinstance(payload, dict):
+        raise ResearchError('research_request_invalid', 422)
+    if command_type == 'research.create':
+        if set(payload) - {'market', 'symbol', 'reportType'}:
+            raise ResearchError('research_request_invalid', 422)
+        from src.services.assistant_finance_commands import normalize_request as normalize_asset
+        try:
+            asset = normalize_asset(dict(payload, expectedRevision=0))
+        except (KeyError, TypeError, AttributeError):
+            raise ResearchError('research_asset_invalid', 422) from None
+        report_type = payload.get('reportType', 'detailed')
+        if report_type not in {'simple', 'detailed'}:
+            raise ResearchError('research_report_type_invalid', 422)
+        return dict(market=asset['market'], symbol=asset['symbol'], reportType=report_type)
+    if set(payload) - {'market', 'strategy', 'maxResults'}:
+        raise ResearchError('research_request_invalid', 422)
+    market, strategy = payload.get('market'), payload.get('strategy')
+    if market not in {'cn', 'crypto'} or not isinstance(strategy, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,64}', strategy):
+        raise ResearchError('research_screening_invalid', 422)
+    count = _integer(payload.get('maxResults', 10), 'max_results', 30)
+    return dict(market=market, strategy=strategy, maxResults=count)
+
+
+def _model_params(config):
+    model = str(getattr(config, 'litellm_model', '') or '').strip()
+    if not model:
+        raise ResearchError('research_model_unconfigured', 503)
+    for deployment in getattr(config, 'llm_model_list', []) or []:
+        if deployment.get('model_name') != model:
+            continue
+        params = dict(deployment.get('litellm_params') or {})
+        if params.get('model') and params.get('api_key') and not str(params['api_key']).startswith('os.environ/'):
+            # Only explicit trusted credential/model routing is supported initially.
+            return {key: params[key] for key in ('model', 'api_key', 'api_base', 'custom_llm_provider', 'extra_headers') if key in params}
+    from src.config import extra_litellm_params, get_api_keys_for_model
+    keys = get_api_keys_for_model(model, config)
+    if not keys:
+        raise ResearchError('research_model_unconfigured', 503)
+    return dict(extra_litellm_params(model, config), model=model, api_key=keys[0])
+
+
+def research_capabilities(config=None, limits=None):
+    """No source/model requests; installation/configuration is not live validation."""
+    limits = limits or ResearchLimits.from_env()
+    reason = 'research_disabled'
+    missing = []
+    if limits.enabled:
+        missing = [name for name in _DEPENDENCIES if importlib.util.find_spec(name) is None]
+        if missing:
+            reason = 'research_dependencies_missing'
+        else:
+            from src.config import get_config
+            try:
+                _model_params(config or get_config())
+                reason = None
+            except ResearchError as exc:
+                reason = exc.code
+    return dict(enabled=reason is None, reason=reason, missingDependencies=missing,
+                requestTokenLimit=limits.request_tokens, dailyTokenLimit=limits.daily_tokens,
+                maxOutputTokens=limits.max_output_tokens, maxActiveRequests=limits.max_active_requests,
+                maxSourceCalls=limits.max_source_calls, requestTimeoutSeconds=limits.request_timeout_seconds,
+                sourceTimeoutSeconds=limits.source_timeout_seconds, sourceCallUnit='provider_operation',
+                cost=None, currency=None, liveTrading=False)
+
+
+@dataclass(frozen=True)
+class ResearchBinding:
+    """Construct only after bridge service authentication, never from HTTP JSON."""
+    service: object
+    issuer: str
+    subject: str
+    database: object
+
+    def recheck(self):
+        from src.services.assistant_bridge_service import BridgeError
+        with suspend_workspace_scope():
+            try:
+                current = self.service.resolve(self.issuer, self.subject)
+            except BridgeError:
+                raise ResearchError('research_binding_disabled', 403) from None
+        if current is not self.database:
+            raise ResearchError('research_binding_changed', 403)
+
+
+def initialize_research_database(database):
+    """Explicit provisioning/migration or POST boundary; never invoke from GET."""
+    if not getattr(database, '_workspace_id', None) or database._engine.url.get_backend_name() != 'sqlite':
+        raise ResearchError('research_workspace_required', 503)
+    with workspace_scope(database), _SCHEMA_LOCK:
+        _Base.metadata.create_all(database._engine)
+
+
+class AssistantResearchService:
+    def __init__(self, database, *, limits=None, config=None, initialize=False, owner=None):
+        if not getattr(database, '_workspace_id', None) or database._engine.url.get_backend_name() != 'sqlite':
+            raise ResearchError('research_workspace_required', 503)
+        self.database = database
+        self.limits = limits or ResearchLimits.from_env()
+        self.config = config
+        self.owner = owner
+        self._check_storage()
+        if initialize:
+            initialize_research_database(database)
+        else:
+            with workspace_scope(database):
+                inspector = inspect(database._engine)
+                if not all(inspector.has_table(table.name) for table in _Base.metadata.sorted_tables):
+                    raise ResearchError('research_schema_uninitialized', 503)
+
+    @contextmanager
+    def _write(self):
+        with _owner_write(self.owner), workspace_scope(self.database), self.database.session_scope() as session:
+            self._check_storage()
+            # One SQLite writer serializes the read/compare/write reservation and
+            # idempotency checks across concurrent threads/processes.
+            session.execute(text('BEGIN IMMEDIATE'))
+            yield session
+
+    def _check_storage(self):
+        path = Path(self.database._engine.url.database)
+        if path.is_symlink() or not path.is_file():
+            raise ResearchError('research_workspace_missing', 503)
+
+    def get(self, request_id):
+        self._check_storage()
+        with workspace_scope(self.database), self.database.get_session() as session:
+            row = session.get(ResearchRequest, request_id)
+            if row is None:
+                raise ResearchError('research_request_not_found', 404)
+            return _request_view(session, row)
+
+    def by_key(self, command_type, key):
+        self._check_storage()
+        with workspace_scope(self.database), self.database.get_session() as session:
+            row = session.scalar(select(ResearchRequest).where(
+                ResearchRequest.command_type == command_type, ResearchRequest.idempotency_key == key))
+            if row is None:
+                raise ResearchError('research_request_not_found', 404)
+            return _request_view(session, row)
+
+    def list(self, limit=50):
+        self._check_storage()
+        _integer(limit, 'list_limit', 100)
+        with workspace_scope(self.database), self.database.get_session() as session:
+            return [_request_view(session, row) for row in session.scalars(select(ResearchRequest).order_by(
+                ResearchRequest.created_at.desc(), ResearchRequest.id.desc()).limit(limit))]
+
+    def create(self, binding, command_type, key, payload):
+        binding.recheck()
+        if binding.database is not self.database:
+            raise ResearchError('research_workspace_mismatch', 403)
+        if not isinstance(key, str) or not re.fullmatch(r'[A-Za-z0-9._:-]{8,128}', key):
+            raise ResearchError('research_idempotency_key_invalid', 422)
+        request = normalize_request(command_type, payload)
+        encoded = _encode(request)
+        request_hash = hashlib.sha256(encoded.encode()).hexdigest()
+        with self._write() as session:
+            prior = session.scalar(select(ResearchRequest).where(
+                ResearchRequest.command_type == command_type, ResearchRequest.idempotency_key == key))
+            if prior:
+                if prior.request_hash != request_hash:
+                    raise ResearchError('research_idempotency_conflict', 409)
+                return _request_view(session, prior), False
+            capability = research_capabilities(self.config, self.limits)
+            if not capability['enabled']:
+                raise ResearchError(capability['reason'], 503)
+            active = session.scalar(select(func.count()).select_from(ResearchRequest).where(ResearchRequest.status.in_(ACTIVE)))
+            if active >= self.limits.max_active_requests:
+                raise ResearchError('research_workspace_busy', 429)
+            row = ResearchRequest(id=uuid4().hex, command_type=command_type, idempotency_key=key,
+                request_hash=request_hash, request_json=encoded, token_limit=self.limits.request_tokens,
+                source_limit=self.limits.max_source_calls, source_calls=0, model_blocked=False,
+                status='queued', created_at=_now())
+            session.add(row)
+            session.flush()
+            return _view(row), True
+
+    def start(self, request_id):
+        with self._write() as session:
+            row = session.get(ResearchRequest, request_id)
+            if row is None or row.status != 'queued':
+                raise ResearchError('research_request_not_queued')
+            row.status, row.started_at = 'running', _now()
+            session.flush()
+            return _view(row)
+
+    def fail(self, request_id, code):
+        with self._write() as session:
+            row = session.get(ResearchRequest, request_id)
+            if row and row.status in ACTIVE:
+                row.status, row.error_code, row.completed_at = 'failed', code, _now()
+
+    def recover_interrupted(self):
+        """Startup/operator-only before admitting work; never automatically resubmit."""
+        with self._write() as session:
+            rows = session.scalars(select(ResearchRequest).where(ResearchRequest.status.in_(ACTIVE))).all()
+            for row in rows:
+                row.status, row.error_code, row.completed_at = 'interrupted', 'research_interrupted', _now()
+            return len(rows)
+
+    def reserve(self, request_id, amount, model, *, now=None):
+        _integer(amount, 'reservation')
+        if not isinstance(model, str) or not 0 < len(model) <= 128:
+            raise ResearchError('research_model_invalid', 422)
+        instant = now or _now()
+        day = instant.date().isoformat()
+        stopped = None
+        call_id = None
+        with self._write() as session:
+            row = session.get(ResearchRequest, request_id)
+            if row is None or row.status != 'running' or row.model_blocked:
+                raise ResearchError(row.error_code if row and row.error_code else 'research_model_run_stopped')
+            budget = session.get(ResearchDay, day)
+            if budget and budget.blocked:
+                raise ResearchError(budget.error_code or 'research_daily_budget_blocked', 429)
+            request_used = session.scalar(select(func.coalesce(func.sum(ResearchCall.charged), 0)).where(ResearchCall.request_id == request_id))
+            day_used = session.scalar(select(func.coalesce(func.sum(ResearchCall.charged), 0)).where(ResearchCall.day == day))
+            if request_used + amount > min(row.token_limit, self.limits.request_tokens):
+                stopped = 'research_request_budget_exhausted'
+            elif day_used + amount > self.limits.daily_tokens:
+                stopped = 'research_daily_budget_exhausted'
+            if stopped:
+                # Commit the stop before raising: an old pipeline may catch an
+                # exception and try a sibling/fallback completion afterwards.
+                row.model_blocked, row.error_code = True, stopped
+            else:
+                if budget is None:
+                    session.add(ResearchDay(day=day, blocked=False))
+                call = ResearchCall(id=uuid4().hex, request_id=request_id, day=day, model=model,
+                    reserved=amount, charged=amount, status='reserved', created_at=instant)
+                session.add(call)
+                session.flush()
+                call_id = call.id
+        if stopped:
+            raise ResearchError(stopped, 429)
+        return call_id
+
+    def record_output(self, call_id, response):
+        choices = getattr(response, 'choices', None)
+        message = getattr(choices[0], 'message', None) if choices else None
+        content = getattr(message, 'content', None)
+        if not isinstance(content, str) or not content:
+            return
+        # Only visible assistant text is archived, never reasoning, headers,
+        # credentials, input messages or an entire provider response object.
+        encoded = _encode(dict(content=content[:100_000], truncated=len(content) > 100_000))
+        with self._write() as session:
+            call = session.get(ResearchCall, call_id)
+            if call is None:
+                raise ResearchError('research_reservation_not_found', 404)
+            call.output_json = encoded
+
+    def settle(self, call_id, prompt_tokens, completion_tokens, total_tokens):
+        valid = (type(prompt_tokens) is int and prompt_tokens > 0
+                 and type(completion_tokens) is int and completion_tokens >= 0
+                 and type(total_tokens) is int and total_tokens == prompt_tokens + completion_tokens)
+        if not valid:
+            self.uncertain(call_id, 'research_usage_unverified')
+            raise ResearchError('research_usage_unverified', 502)
+        overflow = False
+        with self._write() as session:
+            call = session.get(ResearchCall, call_id)
+            if call is None:
+                raise ResearchError('research_reservation_not_found', 404)
+            if call.status == 'settled':
+                if (call.prompt_tokens, call.completion_tokens, call.charged) != (prompt_tokens, completion_tokens, total_tokens):
+                    raise ResearchError('research_settlement_conflict')
+                return
+            call.charged, call.prompt_tokens, call.completion_tokens = total_tokens, prompt_tokens, completion_tokens
+            call.status = 'settled'
+            if total_tokens > call.reserved:
+                request = session.get(ResearchRequest, call.request_id)
+                request.model_blocked, request.error_code = True, 'research_usage_overflow'
+                budget = session.get(ResearchDay, call.day)
+                budget.blocked, budget.error_code = True, 'research_usage_overflow'
+                call.error_code = 'research_usage_overflow'
+                overflow = True
+        if overflow:
+            raise ResearchError('research_usage_overflow', 502)
+
+    def uncertain(self, call_id, code='research_model_call_failed'):
+        with self._write() as session:
+            call = session.get(ResearchCall, call_id)
+            if call is None:
+                raise ResearchError('research_reservation_not_found', 404)
+            if call.status == 'settled':
+                return
+            call.status, call.error_code = 'unknown', code
+            # Conservatively retain the entire debit and stop this UTC day.
+            request = session.get(ResearchRequest, call.request_id)
+            request.model_blocked, request.error_code = True, code
+            budget = session.get(ResearchDay, call.day)
+            budget.blocked, budget.error_code = True, code
+
+    def source_call(self, request_id):
+        with self._write() as session:
+            row = session.get(ResearchRequest, request_id)
+            if row is None or row.status != 'running':
+                raise ResearchError('research_request_not_running')
+            if row.source_calls >= min(row.source_limit, self.limits.max_source_calls):
+                raise ResearchError('research_source_budget_exhausted', 429)
+            row.source_calls += 1
+
+    def usage(self, *, now=None):
+        self._check_storage()
+        day = (now or _now()).date().isoformat()
+        with workspace_scope(self.database), self.database.get_session() as session:
+            calls = session.scalars(select(ResearchCall).where(ResearchCall.day == day)).all()
+            budget = session.get(ResearchDay, day)
+            return dict(day=day, timezone='UTC', tokenLimit=self.limits.daily_tokens,
+                committedTokens=sum(call.charged for call in calls),
+                verifiedTokens=sum(call.charged for call in calls if call.status == 'settled'),
+                unverifiedReservedTokens=sum(call.charged for call in calls if call.status != 'settled'),
+                remainingTokens=max(0, self.limits.daily_tokens - sum(call.charged for call in calls)),
+                blocked=bool(budget and budget.blocked), reason=budget.error_code if budget else None,
+                modelCalls=len(calls), cost=None, currency=None)
+
+    def complete(self, request_id, result):
+        if not isinstance(result, dict) or not result:
+            raise ResearchError('research_result_missing', 502)
+        # Verify references against financial-authoritative storage, not an
+        # arbitrary callback's claimed ID. Preserve the actual result unchanged.
+        with self._write() as session:
+            row = session.get(ResearchRequest, request_id)
+            if row is None or row.status != 'running':
+                raise ResearchError('research_request_not_running')
+            if row.model_blocked or session.scalar(select(func.count()).select_from(ResearchCall).where(
+                ResearchCall.request_id == request_id, ResearchCall.status != 'settled')):
+                raise ResearchError(row.error_code or 'research_usage_unverified', 502)
+            if row.command_type == 'research.create':
+                history = session.scalar(select(AnalysisHistory).where(AnalysisHistory.query_id == request_id).order_by(AnalysisHistory.id.desc()))
+                if history is None:
+                    raise ResearchError('research_result_not_persisted', 502)
+                reference = dict(kind='analysis_history', historyId=history.id, queryId=request_id)
+            else:
+                run_id = result.get('run_id') or result.get('runId')
+                if not isinstance(run_id, str) or not self.database.get_screening_run(run_id):
+                    raise ResearchError('research_result_not_persisted', 502)
+                reference = dict(kind='screening_run', runId=run_id)
+            try:
+                result_json = _encode(result)
+            except (TypeError, ValueError):
+                raise ResearchError('research_result_invalid', 502) from None
+            if len(result_json.encode()) > 2_000_000:
+                raise ResearchError('research_result_too_large', 502)
+            row.status, row.completed_at = 'succeeded', _now()
+            row.result_ref_json, row.result_json = _encode(reference), result_json
+            session.flush()
+            return _request_view(session, row)
+
+
+@dataclass
+class ResearchExecution:
+    service: AssistantResearchService
+    binding: ResearchBinding
+    request_id: str
+    config: object
+    deadline: float
+
+    def recheck(self):
+        if self.service.owner is not None:
+            self.service.owner.recheck()
+        self.binding.recheck()
+        check_database_scope(self.service.database)
+        if time.monotonic() >= self.deadline:
+            raise ResearchError('research_timeout', 504)
+
+
+def current_research_execution():
+    return _EXECUTION.get()
+
+
+def current_research_config():
+    context = _EXECUTION.get()
+    return context.config if context else None
+
+
+@contextmanager
+def research_execution_scope(service, binding, request_id, config=None):
+    binding.recheck()
+    if binding.database is not service.database:
+        raise ResearchError('research_workspace_mismatch', 403)
+    from src.config import get_config
+    isolated = deepcopy(config or service.config or get_config())
+    isolated.database_path = service.database._engine.url.database
+    isolated.max_workers = 1
+    isolated.generation_backend = 'litellm'
+    isolated.agent_generation_backend = 'litellm'
+    isolated.agent_backend = 'auto'
+    isolated.litellm_fallback_models = []
+    isolated.stock_list = []
+    isolated.schedule_enabled = False
+    isolated.agent_event_monitor_enabled = False
+    isolated.agent_orchestrator_timeout_s = service.limits.request_timeout_seconds
+    isolated.agent_deep_research_timeout = service.limits.request_timeout_seconds
+    isolated.fundamental_fetch_timeout_seconds = min(getattr(isolated, 'fundamental_fetch_timeout_seconds', 8), service.limits.source_timeout_seconds)
+    isolated.fundamental_retry_max = 0
+    isolated.report_integrity_retry = 0
+    isolated.markdown_to_image_channels = []
+    context = ResearchExecution(service, binding, request_id, isolated,
+                                time.monotonic() + service.limits.request_timeout_seconds)
+    token = _EXECUTION.set(context)
+    try:
+        with workspace_scope(service.database):
+            yield context
+    finally:
+        _EXECUTION.reset(token)
+
+
+def guard_source_call(label):
+    """Count each provider operation and return its permitted timeout in seconds.
+
+    Callers must forward this timeout to their real transport. This is a source
+    operation quota, not a claim to count internal SDK HTTP retries individually.
+    """
+    context = _EXECUTION.get()
+    if context is None:
+        return None
+    context.recheck()
+    context.service.source_call(context.request_id)
+    return min(context.service.limits.source_timeout_seconds, context.deadline - time.monotonic())
+
+
+def call_research_source(function, *args, source_label='provider', **kwargs):
+    """Guard real provider dispatch; legacy callers retain their exact behavior.
+
+    The inherited bounded source thread cannot kill a third-party SDK already
+    blocked in I/O. It bounds caller wait; SDK HTTP timeouts still govern that
+    operation. Copied workspace/execution context prevents late nested model
+    calls from escaping quota/deadline checks.
+    """
+    if _EXECUTION.get() is None:
+        return function(*args, **kwargs)
+    context = _EXECUTION.get()
+    context.recheck()
+    slots = _SOURCE_SLOTS
+    if not slots.acquire(timeout=min(5, max(0, context.deadline - time.monotonic()))):
+        raise ResearchError('research_source_busy', 429)
+    from src.workspace_scope import ContextThread
+    results = Queue(maxsize=1)
+    def invoke():
+        try:
+            context.recheck()
+            results.put((True, function(*args, **kwargs)))
+        except BaseException as exc:
+            results.put((False, exc))
+        finally:
+            # A timed-out SDK keeps its concurrency slot until it actually exits.
+            slots.release()
+    try:
+        timeout = guard_source_call(source_label)
+        worker = ContextThread(target=invoke, daemon=True, name='assistant-research-source')
+        worker.start()
+    except BaseException:
+        slots.release()
+        raise
+    worker.join(timeout)
+    if worker.is_alive():
+        raise ResearchError('research_source_timeout', 504)
+    ok, value = results.get_nowait()
+    if not ok:
+        raise value
+    return value
+
+
+def research_transport_timeout(fallback):
+    """Forward bounded timeout into a transport without charging another operation."""
+    context = _EXECUTION.get()
+    if context is None:
+        return fallback
+    context.recheck()
+    return min(float(fallback), context.service.limits.source_timeout_seconds,
+               max(.01, context.deadline - time.monotonic()))
+
+
+def assistant_completion(messages, *, tools=None, max_tokens=None, temperature=None):
+    """The sole assistant-context physical model call; reserve before transport."""
+    context = _EXECUTION.get()
+    if context is None:
+        raise ResearchError('research_execution_context_required', 403)
+    context.recheck()
+    requested = max_tokens if max_tokens is not None else context.service.limits.max_output_tokens
+    _integer(requested, 'max_output_tokens')
+    output_limit = min(requested, context.service.limits.max_output_tokens)
+    payload = {'messages': messages, 'tools': tools or []}
+    try:
+        reservation = len(_encode(payload).encode()) + 2048 + output_limit
+    except (ValueError, TypeError):
+        raise ResearchError('research_messages_invalid', 422) from None
+    params = _model_params(context.config)
+    if not _MODEL_SLOTS.acquire(timeout=min(5, max(0, context.deadline - time.monotonic()))):
+        raise ResearchError('research_model_busy', 429)
+    try:
+        context.recheck()
+        call_id = context.service.reserve(context.request_id, reservation, str(params['model']))
+        try:
+            import litellm
+            kwargs = dict(params, messages=messages, max_tokens=output_limit,
+                          timeout=min(45, max(0.01, context.deadline - time.monotonic())),
+                          num_retries=0, stream=False)
+            if tools:
+                kwargs['tools'] = tools
+            if temperature is not None:
+                kwargs['temperature'] = temperature
+            context.recheck()
+            response = litellm.completion(**kwargs)
+            context.service.record_output(call_id, response)
+            usage = getattr(response, 'usage', None)
+            context.service.settle(call_id, getattr(usage, 'prompt_tokens', None),
+                getattr(usage, 'completion_tokens', None), getattr(usage, 'total_tokens', None))
+            return response
+        except Exception as exc:
+            code = exc.code if isinstance(exc, ResearchError) else 'research_model_call_failed'
+            context.service.uncertain(call_id, code)
+            if isinstance(exc, ResearchError):
+                raise
+            raise ResearchError(code, 502) from None
+    finally:
+        _MODEL_SLOTS.release()
+
+
+def _run_request(service, binding, request_id):
+    try:
+        if service.owner is not None:
+            service.owner.recheck()
+        binding.recheck()
+        request = service.start(request_id)
+        with research_execution_scope(service, binding, request_id) as context:
+            context.recheck()
+            payload = request['request']
+            if request['commandType'] == 'research.create':
+                from src.services.analysis_service import AnalysisService
+                backend = AnalysisService()
+                result = backend.analyze_stock(stock_code=payload['symbol'], report_type=payload['reportType'],
+                    query_id=request_id, trace_id=request_id, send_notification=False,
+                    query_source='assistant', agent_mode=False)
+            else:
+                from src.services.screening_service import ScreeningService
+                result = ScreeningService(context.config, service.database).screen(
+                    strategy=payload['strategy'], market=payload['market'], max_results=payload['maxResults'])
+            context.recheck()
+            return service.complete(request_id, result)
+    except Exception as exc:
+        prior_error = service.get(request_id)['error']
+        code = (exc.code if isinstance(exc, ResearchError) else
+                'research_dependencies_missing' if isinstance(exc, (ImportError, ModuleNotFoundError)) else
+                'research_execution_failed')
+        if prior_error:
+            code = prior_error['code']
+        service.fail(request_id, code)
+        raise ResearchError(code, 502) from None
+
+
+def submit_research_request(bridge_service, database, issuer, subject, command_type, key, payload):
+    """Bridge entry point: its issuer/subject must already be service-authenticated."""
+    binding = ResearchBinding(bridge_service, issuer, subject, database)
+    with _OWNER_LOCK:
+        owner = _OWNER
+    service = AssistantResearchService(database, owner=owner)
+    # Disabled/missing-dependency requests retain their precise capability error.
+    # An enabled production runtime must have acquired the lifecycle owner fence.
+    if research_capabilities(service.config, service.limits)['enabled']:
+        if owner is None:
+            raise ResearchError('research_owner_unavailable', 503)
+        owner.recheck()
+    request, created = service.create(binding, command_type, key, payload)
+    if not created:
+        return request
+    try:
+        with research_execution_scope(service, binding, request['id']):
+            from src.services.task_queue import get_task_queue
+            queue = get_task_queue()
+            queue.submit_background_task(lambda: _run_request(service, binding, request['id']),
+                stock_code=request['request'].get('symbol') or 'screening_screen',
+                report_type=command_type, task_id=request['id'], trace_id=request['id'])
+    except Exception as exc:
+        code = exc.code if isinstance(exc, ResearchError) else 'research_queue_unavailable'
+        service.fail(request['id'], code)
+    return service.get(request['id'])
