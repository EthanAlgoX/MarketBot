+"""Read-only financial boundary; all identities come from the trusted service."""
+
+from dataclasses import dataclass
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, Header, HTTPException, Query, Response
+from pydantic import BaseModel, ConfigDict, Field
+from pydantic import ValidationError
+from typing import Literal
+
+from src.services.assistant_bridge_service import AssistantBridgeService, BridgeError, MAX_SAFE_SEQUENCE
+from src.storage import DatabaseManager
+from src.services.assistant_finance_commands import execute_watchlist, get_command
+
+router = APIRouter(prefix='/internal/assistant/v1', tags=['Internal assistant bridge'])
+
+
+@dataclass
+class BridgeContext:
+    service: AssistantBridgeService
+    database: DatabaseManager
+    issuer: str
+    subject: str
+
+
+def require_bridge(
+    response: Response,
+    authorization: Annotated[str | None, Header()] = None,
+    x_assistant_issuer: Annotated[str | None, Header()] = None,
+    x_assistant_subject: Annotated[str | None, Header()] = None,
+):
+    response.headers['Cache-Control'] = 'private, no-store'
+    try:
+        service = AssistantBridgeService()
+        database = service.authenticate(authorization, x_assistant_issuer, x_assistant_subject)
+        return BridgeContext(service, database, x_assistant_issuer, x_assistant_subject)
+    except BridgeError as exc:
+        raise HTTPException(exc.status, detail={'error': exc.code}) from exc
+
+
+Bridge = Annotated[BridgeContext, Depends(require_bridge)]
+
+
+def require_identity(
+    response: Response,
+    authorization: Annotated[str | None, Header()] = None,
+    x_assistant_issuer: Annotated[str | None, Header()] = None,
+    x_assistant_subject: Annotated[str | None, Header()] = None,
+):
+    response.headers['Cache-Control'] = 'private, no-store'
+    try:
+        service = AssistantBridgeService()
+        issuer, subject = service.authenticate_identity(authorization, x_assistant_issuer, x_assistant_subject)
+        return service, issuer, subject
+    except BridgeError as exc:
+        raise HTTPException(exc.status, detail={'error': exc.code}) from exc
+
+
+class SelfBindingRequest(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+
+
+@router.post('/bindings/self')
+def connect_finance(body: SelfBindingRequest,
+                    identity: Annotated[tuple, Depends(require_identity)]):
+    service, issuer, subject = identity
+    return call(service.connect, issuer, subject)
+
+
+def call(fn, *args):
+    from src.services.assistant_research import ResearchError
+    try:
+        return fn(*args)
+    except (BridgeError, ResearchError) as exc:
+        raise HTTPException(exc.status, detail={'error': exc.code}) from exc
+
+
+@router.get('/overview')
+def overview(context: Bridge):
+    return call(context.service.overview, context.database)
+
+
+@router.get('/reports')
+def reports(context: Bridge, offset: Annotated[int, Query(ge=0)] = 0,
+            limit: Annotated[int, Query(ge=1, le=100)] = 20):
+    return call(context.service.reports, context.database, offset, limit)
+
+
+@router.get('/runs/{run_id}')
+def run_detail(run_id: int, context: Bridge):
+    return call(context.service.run_detail, context.database, run_id)
+
+
+@router.get('/runs/{run_id}/days/{record_id}/inputs')
+def run_day_inputs(run_id: int, record_id: int, context: Bridge):
+    return call(context.service.run_inputs, context.database, run_id, record_id)
+
+
+@router.get('/events')
+def events(context: Bridge, after: Annotated[int, Query(ge=0, le=MAX_SAFE_SEQUENCE)] = 0,
+           limit: Annotated[int, Query(ge=1, le=100)] = 100):
+    return call(context.service.events, context.database, after, limit)
+
+
+class WatchlistCommand(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    idempotencyKey: str = Field(min_length=8, max_length=128, pattern=r'^[A-Za-z0-9._:-]+$')
