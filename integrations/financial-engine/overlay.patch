+    market: Literal['cn', 'crypto']
+    name: str = Field(default='', max_length=128)
+    reason: str = Field(default='', max_length=1000)
+
+
+DecimalString = Annotated[str, Field(pattern=r'^(?:0|[1-9][0-9]{0,14})(?:\.[0-9]{1,16})?$')]
+TradingDate = Annotated[str, Field(pattern=r'^\d{4}-\d{2}-\d{2}$')]
+
+
+class SimulationCreateCommand(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    idempotencyKey: str = Field(min_length=8, max_length=128, pattern=r'^[A-Za-z0-9._:-]+$')
+    name: str = Field(min_length=1, max_length=100)
+    market: Literal['cn', 'crypto']
