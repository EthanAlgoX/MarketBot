+)
+from src.storage import (
+    AnalysisHistory, AssistantBridgeBindingRecord, DatabaseManager, PortfolioAccount,
+    PortfolioDailySnapshot, PortfolioPosition,
+)
+from src.workspace_scope import workspace_scope
+
+TOKEN = 'offline-test-token-012345678901234567890'
+ISSUER = 'offline-assistant'
+
+
+@pytest.fixture
+def bridge(tmp_path, monkeypatch):
+    monkeypatch.setenv('ENV_FILE', str(tmp_path / 'no-user-env'))
+    monkeypatch.setenv('FINANCIAL_BRIDGE_TOKEN', TOKEN)
+    monkeypatch.setenv('FINANCIAL_BRIDGE_ISSUER', ISSUER)
+    monkeypatch.setenv('FINANCIAL_SIMULATION_ENABLED', 'false')
+    monkeypatch.setattr(Config, '_instance', Config(database_path=str(tmp_path / 'control.db')))
+    DatabaseManager.reset_instance()
+    service = AssistantBridgeService(DatabaseManager('sqlite:///' + str(tmp_path / 'control.db')))
+    alice = service.bind(ISSUER, 'alice')
+    bob = service.bind(ISSUER, 'bob')
+    app = FastAPI()
+    app.include_router(router)
+    client = TestClient(app)
+    yield client, service, alice, bob
+    reset_bridge_stores()
+    DatabaseManager.reset_instance()
+
+
+def headers(subject='alice', **extra):
+    return {'Authorization': 'Bearer ' + TOKEN, 'X-Assistant-Issuer': ISSUER,
+            'X-Assistant-Subject': subject, **extra}
+
+
+@pytest.mark.parametrize('credentials,status', [
+    ({}, 401),
+    ({'Authorization': 'Bearer incorrect'}, 401),
+    (headers('unbound'), 403),
+    (headers(**{'X-Assistant-Issuer': 'another-issuer'}), 403),
+    (headers(''), 403),
+    (headers('   '), 403),
+])
+def test_service_authentication_fails_closed(bridge, credentials, status):
+    client, *_ = bridge
+    assert client.get('/internal/assistant/v1/overview', headers=credentials).status_code == status
+
+
+def test_missing_configuration_and_disabled_binding_are_not_empty_data(bridge, monkeypatch):
+    client, service, *_ = bridge
+    monkeypatch.delenv('FINANCIAL_BRIDGE_TOKEN')
+    assert client.get('/internal/assistant/v1/overview', headers=headers()).status_code == 503
+    monkeypatch.setenv('FINANCIAL_BRIDGE_TOKEN', TOKEN)
+    service.bind(ISSUER, 'alice', enabled=False)
+    assert client.get('/internal/assistant/v1/overview', headers=headers()).status_code == 403
+
+
+def test_explicit_self_binding_is_stable_private_and_cannot_reenable(bridge):
+    client, service, *_ = bridge
+    path = '/internal/assistant/v1/bindings/self'
+    assert client.get('/internal/assistant/v1/overview', headers=headers('new-owner')).status_code == 403
+    assert client.post(path, json={}, headers={}).status_code == 401
+    assert client.post(path, json={'subject': 'bob'}, headers=headers('new-owner')).status_code == 422
+    first = client.post(path, json={}, headers=headers('new-owner'))
+    assert first.status_code == 200 and first.json() == {'status': 'ready'}
+    db = service.resolve(ISSUER, 'new-owner')
+    stream = service.events(db)['streamId']
+    assert client.post(path, json={}, headers=headers('new-owner')).json() == {'status': 'ready'}
+    assert service.resolve(ISSUER, 'new-owner') is db
+    assert service.events(db)['streamId'] == stream
+    service.bind(ISSUER, 'new-owner', enabled=False)
+    assert client.post(path, json={}, headers=headers('new-owner')).status_code == 403
+
+
+def test_self_binding_concurrent_setup_and_missing_storage_fail_closed(bridge):
+    from concurrent.futures import ThreadPoolExecutor
+    from pathlib import Path
+    client, service, *_ = bridge
+    def connect(_):
+        return client.post('/internal/assistant/v1/bindings/self', json={}, headers=headers('concurrent-owner'))
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        responses = list(pool.map(connect, range(2)))
+    assert [response.status_code for response in responses] == [200, 200]
+    with service.control_db.get_session() as session:
+        rows = session.scalars(select(AssistantBridgeBindingRecord).where(
+            AssistantBridgeBindingRecord.subject == 'concurrent-owner')).all()
+        assert len(rows) == 1
+    database = service.resolve(ISSUER, 'concurrent-owner')
+    path = Path(database._engine.url.database)
