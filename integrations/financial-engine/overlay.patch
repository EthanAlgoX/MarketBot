+    first_position = state['decimalLedger']['positions']['BTCUSDT']
+    assert Decimal(initial['trades'][0]['price']) > 0
+    assert Decimal(first_position['totalCost']) == Decimal(initial['trades'][0]['gross']) + Decimal(initial['trades'][0]['fee'])
+    partial = day('2025-02-11', '0.2')
+    assert partial['trades'][0]['side'] == 'sell'
+    assert Decimal(state['decimalLedger']['positions']['BTCUSDT']['totalCost']) < Decimal(first_position['totalCost'])
+    final = day('2025-02-12', '0')
+    assert state['decimalLedger']['positions'] == {}
+    spent = sum(Decimal(t['gross']) + Decimal(t['fee']) for t in initial['trades'] if t['side'] == 'buy')
+    proceeds = sum(Decimal(t['gross']) - Decimal(t['fee']) for snapshot in [partial, final]
+                   for t in snapshot['trades'] if t['side'] == 'sell')
+    assert Decimal(final['cash']) == Decimal('1000') - spent + proceeds
+
