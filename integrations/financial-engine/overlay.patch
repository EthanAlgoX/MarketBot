+from sqlalchemy import select
+
+from src.config import Config
+from src.services.simulation_portfolio_engine import step
+from src.services.simulation_portfolio_service import SimulationPortfolioService, PortfolioCancelled
+from src.storage import (
+    DatabaseManager, SimulationAccountRecord, SimulationPortfolioRunRecord,
+    SimulationStrategyRecord, SimulationStrategyVersionRecord,
+)
+
+
+def rule_config(**changes):
+    config = dict(name='Deterministic audit', mode='paper', engine='agent', template='agent',
+                market='CRYPTO', symbols=['BTCUSDT'], decisionBackend='rules',
+                initialCash=1000, riskFreeRate=0, maxPositions=1, maxWeight=0.03,
+                lotSize=0.1, commissionRate=0, sellTaxRate=0, slippageRate=0,
+                startDate='2025-02-10')
+    config.update(changes)
+    return config
+
+
+def one_bar(price):
+    return {'BTCUSDT': [{'date': '2025-02-11', 'open': price, 'close': price,
+                         'high': price, 'low': price, 'volume': 1}]}
+
+
+def test_actual_engine_lot_flooring_uses_exact_decimal_inputs():
+    config = rule_config()
+    state = dict(cash=1000, pending=dict(date='2025-02-10', selected=['BTCUSDT'],
+                                        reasons={'BTCUSDT': 'Audit allocation'}))
+    _, output = step(config, state, '2025-02-11', one_bar(100), 100)
+    expected = ((Decimal('1000') * Decimal('0.03') / Decimal('100') / Decimal('0.1'))
+                .to_integral_value(rounding=ROUND_FLOOR) * Decimal('0.1'))
+    assert expected == Decimal('0.3')
+    assert Decimal(str(output['trades'][0]['quantity'])) == expected
+    assert output['cash'] == 970
+    # Compatibility output and storage are still Float. Passing this narrow
+    # arithmetic regression does not release the durable precision gate.
+
+
+def test_actual_engine_cash_fee_slippage_valuation_is_not_double_counted():
+    config = rule_config(maxWeight=0.02, commissionRate=0.001, slippageRate=0.01)
+    state = dict(cash=1000, pending=dict(date='2025-02-10', selected=['BTCUSDT'],
+                                        reasons={'BTCUSDT': 'Audit costs'}))
+    _, output = step(config, state, '2025-02-11', one_bar(100), 100)
+    trade = output['trades'][0]
+    assert trade['quantity'] == 0.1
+    assert trade['price'] == pytest.approx(101)
+    assert trade['fee'] == pytest.approx(0.0101)
+    assert trade['slippage'] == pytest.approx(0.1)
+    assert output['cash'] == pytest.approx(989.8899)
+    assert output['marketValue'] == pytest.approx(10)
+    assert output['equity'] == pytest.approx(999.8899)
+
