+@event.listens_for(Session, 'before_flush')
+@event.listens_for(Session, 'before_commit')
+def _assistant_research_transaction_fence(session, *args):
+    """Keep research ownership through original report/screening commits too."""
+    from src.services.assistant_research import current_research_execution, research_write_fence
+    context = current_research_execution()
+    if context is None or context.service.owner is None or 'assistant_research_write_fence' in session.info:
+        return
+    # Enter only at a database write boundary, never around the source/model SDK.
+    # The owner stop waits for this small transaction; an old worker reaching
+    # its first flush/commit after shutdown is refused before durable writes.
+    guard = research_write_fence()
+    guard.__enter__()
+    session.info['assistant_research_write_fence'] = guard
+
+
+@event.listens_for(Session, 'after_transaction_end')
+def _release_assistant_research_transaction_fence(session, transaction):
+    if transaction.parent is None:
+        guard = session.info.pop('assistant_research_write_fence', None)
+        if guard is not None:
+            guard.__exit__(None, None, None)
