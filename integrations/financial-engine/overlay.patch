@@ -0,0 +1,196 @@
+"""One financial-process owner of trusted assistant workspace daily runs."""
+import asyncio
+from contextlib import contextmanager
+from contextvars import ContextVar
+import fcntl
+import logging
+import os
+from pathlib import Path
+
+from sqlalchemy import select
+
+from src.services.assistant_bridge_service import AssistantBridgeService, BridgeError
+from src.storage import AssistantBridgeBindingRecord
+from src.workspace_scope import workspace_scope, suspend_workspace_scope
+
+_RECHECK = ContextVar('assistant_simulation_authorization', default=None)
+_LOG = logging.getLogger(__name__)
+
+
+def enabled():
+    return os.getenv('FINANCIAL_SIMULATION_ENABLED', '').lower() == 'true'
+
+
+def bridge_configured():
+    issuer = os.getenv('FINANCIAL_BRIDGE_ISSUER', '').strip()
+    return len(os.getenv('FINANCIAL_BRIDGE_TOKEN', '')) >= 32 and 0 < len(issuer) <= 128
+
+
+class AssistantProcessOwner:
+    """One owner for research recovery and daily simulation in either API app."""
+    def __init__(self, service=None):
+        self.service = service or AssistantBridgeService()
+        self.lock = None
+        self.research_owner = None
+        self.stopping = False
+
+    def acquire(self):
+        path = Path(self.service.control_db._engine.url.database).resolve().parent / 'assistant-process.lock'
+        self.lock = path.open('a')
+        try:
+            fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            self.lock.close()
+            self.lock = None
+            raise RuntimeError('Financial assistant process already has an owner')
+
+    def recover_research(self):
+        from src.services.assistant_research import AssistantResearchService, ResearchError
+        # Only existing trusted workspace mappings are scanned. Disabled research
+        # still needs honest interrupted states; recovery never invokes a model.
+        with self.service.control_db.get_session() as session:
+            workspaces = list(session.scalars(select(AssistantBridgeBindingRecord.workspace_id).where(
+                AssistantBridgeBindingRecord.enabled.is_(True))))
+        recovered = 0
+        for workspace_id in workspaces:
+            try:
+                database = self.service.database(workspace_id)
+                research = AssistantResearchService(database, owner=self.research_owner, initialize=False)
+                recovered += research.recover_interrupted()
+            except (BridgeError, ResearchError) as exc:
+                # Missing files/schema remain unavailable until explicit repair;
+                # a startup recovery must not provision or rebuild financial data.
+                _LOG.warning('Assistant research recovery unavailable: %s', exc.code)
+        return recovered
+
+    async def start(self):
+        from src.services.assistant_research import start_research_owner, stop_research_owner
+        self.acquire()
+        try:
+            self.research_owner = start_research_owner()
+            return await asyncio.to_thread(self.recover_research)
+        except BaseException:
+            if self.research_owner is not None:
+                stop_research_owner(self.research_owner)
+                self.research_owner = None
+            self.release()
+            raise
+
+    def fence(self):
+        self.stopping = True
+        if self.research_owner is not None:
+            from src.services.assistant_research import stop_research_owner
+            stop_research_owner(self.research_owner)
+            self.research_owner = None
+
+    def release(self):
+        if self.lock:
+            fcntl.flock(self.lock, fcntl.LOCK_UN)
+            self.lock.close()
+            self.lock = None
+
+    async def stop(self):
+        self.fence()
+        self.release()
+
+
+def recheck():
+    callback = _RECHECK.get()
+    if callback:
+        callback()
+
+
+@contextmanager
+def execution_identity(service, workspace_id, *, alive=lambda: True):
+    def verify():
+        if not alive():
+            raise BridgeError('simulation_owner_stopping', 503)
+        with suspend_workspace_scope(), service.control_db.get_session() as session:
+            active = session.scalar(select(AssistantBridgeBindingRecord.id).where(
+                AssistantBridgeBindingRecord.workspace_id == workspace_id,
+                AssistantBridgeBindingRecord.enabled.is_(True)))
+            if active is None:
+                raise BridgeError('bridge_identity_unbound', 403)
+            # Cached SQLAlchemy engines must not reconnect and recreate a
+            # workspace file lost while this job was queued or in flight.
+            service.database(workspace_id)
+    verify()
+    token = _RECHECK.set(verify)
+    try:
+        yield
+    finally:
+        _RECHECK.reset(token)
+
+
+class AssistantSimulationScheduler:
+    def __init__(self, service=None, *, owner=None):
+        self.owner = owner
+        self.service = service or (owner.service if owner else AssistantBridgeService())
+        self.recovered = set()
+        self.lock = None
+        self.task = None
+        self.stopping = False
+        self.active_tick = None
+
+    def acquire(self):
+        if self.owner is not None:
+            if self.owner.lock is None or self.owner.stopping:
+                raise RuntimeError('Financial assistant process owner is unavailable')
+            return
+        path = Path(self.service.control_db._engine.url.database).resolve().parent / 'assistant-process.lock'
+        self.lock = path.open('a')
+        try:
+            fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            self.lock.close()
+            self.lock = None
+            raise RuntimeError('Financial assistant scheduler already has an owner')
+
+    def tick(self):
+        from src.services.simulation_portfolio_service import SimulationPortfolioService
+        with self.service.control_db.get_session() as session:
+            workspaces = list(session.scalars(select(AssistantBridgeBindingRecord.workspace_id).where(
+                AssistantBridgeBindingRecord.enabled.is_(True))))
+        for workspace_id in workspaces:
+            if self.stopping:
+                return
+            try:
+                database = self.service.database(workspace_id)
+                with execution_identity(self.service, workspace_id, alive=lambda: not self.stopping), workspace_scope(database):
+                    engine = SimulationPortfolioService(database)
+                    if workspace_id not in self.recovered:
+                        engine.recover(assistant_only=True)
+                        self.recovered.add(workspace_id)
+                    engine.due(assistant_only=True)
+            except Exception:
+                _LOG.exception('Assistant simulation workspace check failed')
+
+    async def loop(self):
+        while True:
+            self.active_tick = asyncio.create_task(asyncio.to_thread(self.tick))
+            await asyncio.shield(self.active_tick)
+            self.active_tick = None
+            await asyncio.sleep(30)
+
+    async def start(self):
+        self.acquire()
+        self.task = asyncio.create_task(self.loop())
+
+    async def stop(self):
+        self.stopping = True
+        if self.task:
+            self.task.cancel()
+            try:
+                await self.task
+            except asyncio.CancelledError:
+                pass
+        # Cancelling to_thread's await does not terminate its worker. Keep
+        # ownership until that actual tick exits; queued financial workers
+        # also recheck this owner's stopping flag before a ledger commit.
+        if self.active_tick:
+            await asyncio.shield(self.active_tick)
+            self.active_tick = None
+        if self.lock:
+            fcntl.flock(self.lock, fcntl.LOCK_UN)
+            self.lock.close()
+            self.lock = None
