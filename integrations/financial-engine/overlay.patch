+def test_shutdown_waits_for_entered_write_transaction_but_blocks_followup(stores, monkeypatch):
+    from threading import Event
+    service, binding = setup(stores, monkeypatch)
+    fence = research.start_research_owner()
+    service.owner = fence
+    request_id = running(service, binding)
+    entered, finish, stopped = Event(), Event(), Event()
+    def write():
+        with service._write() as session:
+            entered.set()
+            assert finish.wait(3)
+            session.get(research.ResearchRequest, request_id).source_calls += 1
+    def stop():
+        research.stop_research_owner(fence)
+        stopped.set()
+    try:
+        with ThreadPoolExecutor(max_workers=2) as executor:
+            writer = executor.submit(write)
+            assert entered.wait(2)
+            shutdown = executor.submit(stop)
+            assert not stopped.wait(.1), 'Owner unlocked before an admitted write committed'
+            finish.set()
+            writer.result(timeout=3)
+            shutdown.result(timeout=3)
+        with pytest.raises(research.ResearchError, match='research_owner_stopped'):
+            service.reserve(request_id, 10, 'offline-model')
+        with workspace_scope(service.database), service.database.get_session() as session:
+            assert session.get(research.ResearchRequest, request_id).source_calls == 1
+    finally:
+        finish.set()
+        research.stop_research_owner(fence)
