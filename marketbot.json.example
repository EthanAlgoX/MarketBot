{
  "meta": {
    "version": "1.0.0"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama-local",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen3:0.6b",
            "name": "Qwen3 0.6B Instruct (Local)",
            "reasoning": false,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 32768,
            "maxTokens": 8192
          }
        ]
      },
      // Example: External API (DeepSeek, OpenAI, etc.)
      /*
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": "YOUR_API_KEY_HERE",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek Chat",
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }
      */
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/qwen3:0.6b"
        // "primary": "deepseek/deepseek-chat" // Uncomment to use external API
      },
      "workspace": "~/.marketbot/workspace",
      "maxConcurrent": 4
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "change-me-in-local-config"
    }
  },
  "skills": {
    "install": {
      "nodeManager": "npm"
    }
  }
}
