{
  "name": "@marketbot/desktop",
  "productName": "金融助手",
  "version": "0.1.6",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "pack": "pnpm --filter @marketbot/web build && pnpm build && electron-builder --mac --win --linux",
    "pack:dir": "pnpm --filter @marketbot/web build && pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @marketbot/web build && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@marketbot/contracts": "workspace:*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@marketbot/ui-tokens": "workspace:*",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "dev.marketbot.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../infra/compose/docker-compose.images.yml",
        "to": "stack/docker-compose.images.yml"
      },
      {
        "from": "../../infra/compose/.env.images.example",
        "to": "stack/.env.images.example"
      }
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "../../packages/ui-tokens/assets/MarketBot.icon",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true
    },
    "linux": {
      "executableName": "marketbot",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": null
  },
  "x-project-modifications": "Modified for marketbot on 2026-10-13; see MODIFICATIONS.md."
}
