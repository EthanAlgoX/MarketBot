{
  "name": "marketbot-desktop",
  "productName": "MarketBot Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MarketBot Desktop Control UI",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "pnpm build && electron out/main/index.js",
    "package:mac": "bash scripts/package-desktop.sh --mac",
    "package:win": "bash scripts/package-desktop.sh --win",
    "package:linux": "bash scripts/package-desktop.sh --linux",
    "package:all": "bash scripts/package-desktop.sh --all",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.1.1",
    "electron-builder": "^26.7.0",
    "electron-vite": "^3.0.0",
    "electron-updater": "^6.7.3",
    "typescript": "^5.9.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "ai.marketbot.desktop",
    "productName": "MarketBot Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "dist/renderer/**",
      "preload.cjs",
      "webview-preload.cjs"
    ],
    "extraResources": [
      {
        "from": "gateway-bundle/",
        "to": "gateway-bundle",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        "deb",
        "rpm"
      ],
      "category": "Finance"
    },
    "dmg": {
      "background": "../../assets/dmg-background.png",
      "iconSize": 128,
      "contents": [
        {
          "x": 150,
          "y": 180
        },
        {
          "x": 430,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://marketbot.ai/desktop"
      }
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
