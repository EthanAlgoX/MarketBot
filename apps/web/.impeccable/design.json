  "narrative": {
    "northStar": "金融工作台",
    "overview": "采用项目的单色操作界面：Geist 文本、语义色、轻边界和渐进展开。界面让用户读取来源、检查状态并完成明确操作，视觉层级来自内容顺序、字重和留白。\n\n同一套 Web 页面服务浏览器与 Electron；金融工作台的窄屏 Web 保留相同内容层级。原生 Expo 使用共享颜色语义和系统控件，平台导航与触控规范在原生实现中决定，本文的 Web 尺寸不能直接移植为原生尺寸。",
    "keyCharacteristics": [
      "单色主操作与语义状态色。",
      "行列表、分隔线和展开详情构成信息层级。",
      "浅色、深色沿用同名语义 token。",
      "金额、业务日期、来源和数据质量保留各自含义。"
    ],
    "rules": [
      {
        "name": "The Semantic Slot Rule",
        "body": "相同 token 在 Web、Electron 和原生自定义表面保持相同用途，边框色不被拿来代替容器底色。",
        "section": "colors"
      },
      {
        "name": "The Financial Value Rule",
