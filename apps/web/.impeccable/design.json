      "html": "<nav class=\"ds-finance-nav\" aria-label=\"金融工作台导航\"><button class=\"ds-finance-tab\" aria-pressed=\"false\">总览</button><button class=\"ds-finance-tab\" aria-pressed=\"true\">新闻与日报</button><button class=\"ds-finance-tab\" aria-pressed=\"false\">持仓</button><button class=\"ds-finance-tab\" aria-pressed=\"false\">研究</button><button class=\"ds-finance-tab\" aria-pressed=\"false\">模拟策略</button><button class=\"ds-finance-tab\" aria-pressed=\"false\">服务状态</button></nav>",
      "css": ".ds-finance-nav{display:flex;gap:4px;padding:8px 0;overflow-x:auto;border-bottom:1px solid var(--border,#1e2026);}.ds-finance-tab{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:calc(var(--radius,.75rem));font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;transition:all 150ms cubic-bezier(.4,0,.2,1);font-family:\"Geist Variable\",ui-sans-serif,system-ui,sans-serif;background:transparent;color:var(--foreground,#ececee);}.ds-finance-tab[aria-pressed=\"true\"]{background:var(--secondary,#18191e);}.ds-finance-tab:hover{background:var(--muted,#141518);}.ds-finance-tab:focus-visible{outline:none;border-color:var(--ring,#3b82f6);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#3b82f6) 50%,transparent);}.ds-finance-tab:active{transform:translateY(1px);}@media(max-width:639px){.ds-finance-tab{min-height:44px;}}"
