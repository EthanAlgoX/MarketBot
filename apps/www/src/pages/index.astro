---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { START_HREF, START_LABEL } from "../site";

const workflows = [
  { title: "只关注与你有关的消息", detail: "按自选标的、来源和关键词订阅新闻。先预览匹配内容，再将关心的消息汇总成日报。", output: "订阅预览 / 每日日报" },
  { title: "让持仓与判断都有记录", detail: "导入模板交易记录，查看持仓数量与资金流水。新闻、日报和研究观察留存下来，方便回看当时的依据。", output: "持仓账本 / 信息归档" },
  { title: "用模拟检验策略", detail: "在 BTC 日线数据上运行已支持的策略，查看买卖操作、成交记录和模拟账本；运行可以暂停、恢复或停止。", output: "模拟盯盘 / 操作提醒" },
  { title: "把研究变成可复盘的草稿", detail: "模型服务配置完成后，可记录研究观察及失效条件，保存策略草稿。草稿经确认后再用于创建模拟。", output: "研究观察 / 策略草稿", note: "需要配置模型服务" },
];
---

<BaseLayout>
  <!--
    THESIS: A personal research desk where information, holdings and simulated decisions form one reviewable workflow.
    OWN-WORLD: The existing monochrome system, shared semantic tokens, system typography, crisp dividers and an original line mark.
    STORY: Understand the current tools, see their limits, then enter the configured workspace or local setup guide.
    FIRST VIEWPORT: A left-aligned statement and action beside a plain four-step workflow, with scope visible below.
    FORM: A precise branding and content refinement inside the established visual system; no invented financial results.
  -->
  <Header />
  <main id="main">
    <section class="hero container" aria-labelledby="headline">
      <div class="hero-copy">
        <p class="version">个人投研工作台 · 开发版</p>
        <h1 id="headline">关注市场，<br />也看清自己的判断。</h1>
        <p class="lead">把新闻、持仓和策略模拟放在一起。<br class="desktop-break" />从每天的新消息，到可以回看的交易依据。</p>
        <div class="hero-actions">
          <a class="button" href={START_HREF}>{START_LABEL}<span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#workflow">了解功能 <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <aside class="workflow-preview" aria-label="工作流程">
        <p class="preview-heading">你的投研流程</p>
        <ol class="process-list">
          <li><span class="process-title">关注</span><span>自选标的、新闻来源、关键词</span></li>
          <li><span class="process-title">记录</span><span>日报、持仓、研究观察</span></li>
          <li><span class="process-title">模拟</span><span>策略运行、买卖操作、账本</span></li>
          <li><span class="process-title">复盘</span><span>回看消息、判断和模拟结果</span></li>
        </ol>
      </aside>
    </section>

    <section class="platform-note container" aria-label="支持的平台">
      <p>电脑与手机，共用一份投研记录。</p>
      <span>Web / 桌面 / 移动端界面</span>
    </section>

    <section id="workflow" class="section container" aria-labelledby="workflow-title">
      <div class="section-heading">
        <h2 id="workflow-title">从信息到行动，<br />每一步都能回看。</h2>
        <p>消息有来源，模拟有账本，<br />判断留下记录。</p>
      </div>
      <div class="feature-list">
        {workflows.map((workflow) => (
          <article class="feature-row">
            <h3>{workflow.title}</h3>
            <div>
              <p>{workflow.detail}</p>
              {workflow.note && <p class="feature-note">{workflow.note}</p>}
            </div>
            <span class="feature-output">{workflow.output}</span>
          </article>
        ))}
      </div>
    </section>

    <section id="scope" class="section scope container" aria-labelledby="scope-title">
      <div class="section-heading">
        <h2 id="scope-title">当前版本</h2>
        <p>先建立可靠的记录与模拟流程。</p>
      </div>
      <dl class="scope-list">
        <div><dt>可以开始</dt><dd>自选管理、新闻订阅与日报归档、模板持仓导入、站内提醒、已支持策略的 BTC 日线模拟。</dd></div>
        <div><dt>需要配置或验收</dt><dd>模型研究与选股需要模型服务；A 股实际行情、个人策略适配、手机真机推送及长时间运行仍待验收。</dd></div>
        <div><dt>交易范围</dt><dd>当前买卖操作发生在模拟账户。尚未接入实盘交易。</dd></div>
      </dl>
      <div class="closing-action">
        <p>先从你的自选列表开始。</p>
        <a class="button" href={START_HREF}>{START_LABEL}<span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
